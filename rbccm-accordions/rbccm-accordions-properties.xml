<!--
  RBCCM Accordions - Properties + Data
  ==============================================================
  Preset-driven accordion-section component. The Preset Datum picks
  the variant; each variant has its own set of content Datums that
  live in the same file. Unused Datums for a given preset are
  ignored by the XSL (matches the tabbed-panels + rbccm-hero
  pattern).

  Presets:
    strategy-and-economics-notes  Dark navy notes section with
                                  eyebrow / byline / title / summary
                                  and an expandable body per row.
                                  Author fills up to 8 note slots;
                                  blank Category label hides the row.

  SEMANTIC TAG PICKER PATTERN
  ==============================================================
  Every editable text field ships as a pair:
    <Field>Text       String / Textarea with the copy itself
    <Field>Tag        Enum picker: h1 | h2 | h3 | h4 | h5 | h6
                                 | p  | div | span
  The XSL emits the tag dynamically via xsl:element name="{tag}",
  so authors can promote a title to <h2> for SEO, drop a category
  eyebrow to a <p>, etc.

  Sidecar assets are loaded from paths declared below and cache-
  busted via ?v={CacheVersion} appended by the XSL. See the
  "Last updated" Datum at the top of the Data block - editors
  bump it after each content save and it doubles as the cache
  buster.
-->
<Properties ComponentID="rbccm-accordions">
</Properties>

<Data>

  <!-- ============================================================
       Last updated
       ============================================================
       Bump this timestamp every time you save content changes to
       this section. Format: YYYY-MM-DD-HHMM (24-hour clock).
       - Serves as a human record of when the section was last
         touched (visible at a glance to the next editor).
       - Also appended to the sidecar CSS + JS URLs as ?v={...}
         so browsers refetch the latest assets after a deploy.
       Example: 2026-09-12-1934  =  Sep 12 2026 at 7:34 PM
       ============================================================ -->
  <Datum ID="CacheVersion" Type="String" Name="Last updated (bump each time you save content - format: YYYY-MM-DD-HHMM, e.g. 2026-09-12-1934)">2026-09-12-1934</Datum>

  <!-- ============================================================
       Section identity + shared meta
       ============================================================
       What editors set here: nothing. Deploy-time plumbing.
       ============================================================ -->
  <Datum ID="SectionID" Type="String" Name="Section ID (technical - set once at deploy, editors don't change)">rbccm-accordions-1</Datum>
  <Datum ID="SectionAriaLabel" Type="String" Name="Section ARIA label (technical - set once at deploy, editors don't change)">Notes</Datum>

  <Datum ID="CssPath" Type="String" Name="Sidecar CSS path (technical - set once at deploy, editors don't change)">/assets/rbccm/css/components/rbccm-accordions.css</Datum>
  <Datum ID="JsPath" Type="String" Name="Sidecar JS path (technical - set once at deploy, editors don't change)">/assets/rbccm/js/components/rbccm-accordions.js</Datum>

  <!-- Once a preset is picked, only that variant's Datums render -
       unused Datums for other presets are ignored. -->
  <Datum ID="Preset" Type="String" Name="Preset - component variant (required - pick one)" Label="Component variant">
    <Option>
      <Display>Strategy and Economics Notes (dark navy, expandable notes)</Display>
      <Value>strategy-and-economics-notes</Value>
    </Option>
    strategy-and-economics-notes
  </Datum>


  <!-- ============================================================
       Section header (title + description + Expand all)
       ============================================================
       What editors set here: the big headline and short description
       that sit at the top of the section, plus the labels on the
       Expand all / Collapse all toggle. The tag pickers let you
       promote the title to h2 for SEO.
       .............................................................
       Header alignment. left = base (no modifier); center adds the
       .rbccm-accordions__header-center modifier that centers the
       title + description block. (Class name in this comment uses __
       in place of the BEM double-hyphen modifier so the XML comment
       stays well-formed; emitted markup uses the real BEM double-
       hyphen prefix.)
       ============================================================ -->
  <Datum ID="HeaderAlignment" Type="String" Name="Header alignment (optional - controls how the title block is aligned)">
    <Option Selected="true"><Display>Left</Display><Value>left</Value></Option>
    <Option><Display>Center</Display><Value>center</Value></Option>
    left
  </Datum>

  <Datum ID="SectionTitleText" Type="String" Name="Section title (required - do not blank)">S&amp;E Notes</Datum>
  <Datum ID="SectionTitleTag" Type="String" Name="Section title tag (optional - controls the HTML tag for SEO / a11y)">
    <Option><Display>h1</Display><Value>h1</Value></Option>
    <Option><Display>h2</Display><Value>h2</Value></Option>
    <Option><Display>h3</Display><Value>h3</Value></Option>
    <Option><Display>h4</Display><Value>h4</Value></Option>
    <Option><Display>h5</Display><Value>h5</Value></Option>
    <Option><Display>h6</Display><Value>h6</Value></Option>
    <Option><Display>p</Display><Value>p</Value></Option>
    <Option><Display>div</Display><Value>div</Value></Option>
    <Option><Display>span</Display><Value>span</Value></Option>
    h2
  </Datum>

  <Datum ID="SectionDescriptionText" Type="Textarea" Name="Section description (optional - blank hides the description; HTML allowed)">Timely, short-form commentary from our economists and strategists.</Datum>
  <Datum ID="SectionDescriptionTag" Type="String" Name="Section description tag (optional - controls the HTML tag for SEO / a11y)">
