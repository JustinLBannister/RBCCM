  <Datum ID="ExpandAllLabel" Type="String" Name="Expand-all button label - collapsed state (required - do not blank)">Expand all</Datum>
  <Datum ID="CollapseAllLabel" Type="String" Name="Expand-all button label - expanded state (required - do not blank)">Collapse all</Datum>


