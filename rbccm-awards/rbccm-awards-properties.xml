<!-- ============================================================
     RBCCM Awards  |  Properties + Data
     ============================================================
     Standalone TeamSite skin for a row of award cards on a dark
     background. Extracted from the MAAS+MATA landing page so any
     page (US Credentials, Canadian Credentials, product landing
     pages, etc.) can drop it in.

     Sections
     ============================================================
     1  Deploy plumbing   CssPath + CacheVersion + Preset + IDs
     2  Section eyebrow   optional caption above the cards
     3  Card 1 to 4       year / title / issuer per slot
                          (Preset picks how many cards render;
                           extra Card{N} slots are ignored)

     Presets
     ============================================================
     awards-3   3-up grid (MAAS+MATA original)
     awards-4   4-up grid (US Credentials)
     ============================================================ -->
<Properties ComponentID="rbccm-awards-v1">

  <!-- ============================================================
       Preset
       ============================================================ -->
  <Datum ID="Preset" Type="String" Name="Layout preset">
    <Option Value="awards-3" Selected="true">3-card grid</Option>
    <Option Value="awards-4">4-card grid</Option>
  </Datum>

  <!-- ============================================================
       Deploy plumbing
       ============================================================
       CssPath  absolute URL to rbccm-awards.css (site chrome).
       CacheVersion  bumped when CSS changes so browsers refetch.
       SectionID  optional id="" on the section for anchor links.
       SectionAriaLabel  optional aria-label override; defaults
                         to "Awards" when blank. -->
  <Datum ID="CssPath" Type="String" Name="CSS path (absolute URL)">/assets/rbccm/css/components/rbccm-awards.css</Datum>
  <Datum ID="JsPath" Type="String" Name="JS path (absolute URL - powers the mobile carousel)">/assets/rbccm/js/components/rbccm-awards.js</Datum>
  <Datum ID="CacheVersion" Type="String" Name="Cache version (format YYYY-MM-DD-HHMM)">2026-09-21-1600</Datum>
  <Datum ID="SectionID" Type="String" Name="Section ID (optional - anchor target)">rbccm-awards-1</Datum>
  <Datum ID="SectionAriaLabel" Type="String" Name="Section aria-label (optional - defaults to 'Awards')"></Datum>

  <!-- ============================================================
       Section background colour
       ============================================================
       Presets carry their own default background so an author never
       has to pick one:

         awards-3  →  #041e42  (MAAS+MATA navy)
         awards-4  →  #051B38  (US Credentials navy)

       This picker overrides that default. The first option keeps
       the preset default; the next two are the named page palettes
       so an author can align an awards section on one page to the
       other page's colour without typing a hex. Custom lets an
       author paste any CSS colour value (#hex, rgb(), rgba(), hsl(),
       a named colour, or a CSS custom property).

       Under the hood the picked value ships as an inline
       CSS custom property (rbccm-awards-bg) on the section — the
       same token the CSS preset defaults use. -->
  <Datum ID="SectionBgColor" Type="String" Name="Section background colour">
    <Option Value="" Selected="true">Default (inherits from preset)</Option>
    <Option Value="#051B38">US Credentials navy (#051B38)</Option>
    <Option Value="#041e42">MAAS+MATA navy (#041e42)</Option>
    <Option Value="custom">Custom (edit the XML value directly)</Option>
  </Datum>

  <!-- ============================================================
       Section eyebrow (optional)
       ============================================================
       Caption line above the cards. Figma spec: Roboto 16/19.2
       weight 500, letter-spacing 1.92, colour #C3C3C3, sentence
       case, centred. Blank Datum hides the line entirely. -->
  <Datum ID="SectionEyebrowText" Type="String" Name="Section eyebrow (optional - e.g. 'See why the world's top institutions choose MAAS')">See why the world's top institutions choose MAAS</Datum>

  <!-- ============================================================
       Card 1
       ============================================================ -->
  <Datum ID="Card1Year" Type="String" Name="Card 1 : year (e.g. '2026')">2026</Datum>
  <Datum ID="Card1Title" Type="String" Name="Card 1 : title (blank hides the card)">Best Trading Analytics Platform</Datum>
  <Datum ID="Card1Issuer" Type="String" Name="Card 1 : issuer">TradingTech Insights Awards USA</Datum>

  <!-- ============================================================
       Card 2
       ============================================================ -->
  <Datum ID="Card2Year" Type="String" Name="Card 2 : year">2025</Datum>
  <Datum ID="Card2Title" Type="String" Name="Card 2 : title">Overall Best Provider, Algorithmic Trading</Datum>
  <Datum ID="Card2Issuer" Type="String" Name="Card 2 : issuer">The Trade</Datum>

  <!-- ============================================================
       Card 3
       ============================================================ -->
  <Datum ID="Card3Year" Type="String" Name="Card 3 : year">2025</Datum>
  <Datum ID="Card3Title" Type="String" Name="Card 3 : title">Best Provider, Multi-User Clients</Datum>
  <Datum ID="Card3Issuer" Type="String" Name="Card 3 : issuer">The Trade</Datum>

  <!-- ============================================================
       Card 4  (only rendered when Preset = awards-4)
       ============================================================ -->
  <Datum ID="Card4Year" Type="String" Name="Card 4 : year (Preset awards-4 only)"></Datum>
  <Datum ID="Card4Title" Type="String" Name="Card 4 : title (Preset awards-4 only - blank hides the card)"></Datum>
  <Datum ID="Card4Issuer" Type="String" Name="Card 4 : issuer (Preset awards-4 only)"></Datum>

</Properties>

<!-- No repeater Groups in this component; every content field lives
     in Properties above. Empty Data block kept because TeamSite's
     component schema expects it to be present. -->
<Data>
</Data>
