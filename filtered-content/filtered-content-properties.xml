<!--
  RBCCM Filtered Content - Properties

  Component publishes one of three preset variants driven by the
  Preset Datum. Content editors pick a preset per instance; the
  filter chrome + list container render the same way, only the
  data source and item template differ.

  Preset values (must match a BEM modifier in filtered-content.css):
    conference-insights
    in-the-media-and-press-releases
    deals-and-transactions

  For the in-the-media-and-press-releases preset ONLY, the External
  block below runs a MetaQueryExternal query at publish time and
  the XSL iterates the metaResult set inline. Widened from the
  About-page query to INCLUDE topic:press so both media coverage
  AND press releases render in one list. The Type dropdown lets
  users narrow to one or the other.

  For conference-insights and deals-and-transactions, the External
  block is unused. filtered-content.js fetches the respective DCR
  feeds on page load. The Preset Datum still drives the outer
  section's modifier class so the JS coordinator picks the right
  adapter.

  Structure note: content Datums live inside <Data> (matches the
  About-page pattern the XSL was modeled on). The XSL reads them
  via /Properties/Data/Datum[@ID='X'].
-->
<Properties ComponentID="rbccm-filtered-content">
</Properties>

<Data>

  <!-- Preset selector: picks which variant this instance renders as.
       Each <Option> is element-only (Display label + Value machine-
       value children). The bare text after the closing </Option> is
       the default value. -->
  <Datum ID="Preset" Type="String" Name="Preset" Label="Component variant">
    <Option>
      <Display>In the Media &amp; Press Releases</Display>
      <Value>in-the-media-and-press-releases</Value>
    </Option>
    <Option>
      <Display>Conference Insights</Display>
      <Value>conference-insights</Value>
    </Option>
    <Option>
      <Display>Deals &amp; Transactions</Display>
      <Value>deals-and-transactions</Value>
    </Option>
    in-the-media-and-press-releases
  </Datum>

  <!-- Section identity + pagination. -->
  <Datum ID="SectionID" Type="String" Name="Section ID (unique per page)">rbccm-filtered-content-1</Datum>
  <Datum ID="SectionAriaLabel" Type="String" Name="Section ARIA label">Filter articles</Datum>

  <Datum ID="PageSize" Type="Number" Name="Items per page (default view)">10</Datum>
  <Datum ID="PageSizeFiltered" Type="Number" Name="Items per page (when a filter is active)">10</Datum>

  <!-- Filter chrome: dropdown visibility per preset. Set false to
       hide a dimension entirely (e.g. Deals preset hides Type,
       Month, Region, Search). -->
  <Datum ID="ShowType" Type="Boolean" Name="Show Type dropdown">true</Datum>
  <Datum ID="ShowYear" Type="Boolean" Name="Show Year dropdown">true</Datum>
  <Datum ID="ShowMonth" Type="Boolean" Name="Show Month dropdown">true</Datum>
  <Datum ID="ShowRegion" Type="Boolean" Name="Show Region dropdown">true</Datum>
  <Datum ID="ShowSearch" Type="Boolean" Name="Show search input">true</Datum>

  <Datum ID="FilterByLabel" Type="String" Name="'Filter by:' label">Filter by:</Datum>
  <Datum ID="ClearFiltersLabel" Type="String" Name="Clear filters button label">Clear filters</Datum>

  <Datum ID="SearchPlaceholder" Type="String" Name="Search input placeholder">Search media coverage and/or press releases</Datum>
  <Datum ID="SearchAriaLabel" Type="String" Name="Search input ARIA label">Search media coverage and/or press releases by title or keyword</Datum>
  <Datum ID="SearchScreenReaderLabel" Type="String" Name="Search input SR only label">Search media coverage and/or press releases</Datum>

  <!-- Empty state (rendered by JS when filters return zero results). -->
  <Datum ID="EmptyHeading" Type="String" Name="Empty state heading">No results found</Datum>
  <Datum ID="EmptyMessage" Type="String" Name="Empty state message">We couldn't find any results that match your current filters.</Datum>
  <Datum ID="EmptyMessageEmphasis" Type="String" Name="Empty state emphasized message">Try adjusting your filters or search terms.</Datum>
  <Datum ID="EmptyClearLabel" Type="String" Name="Empty state clear button label">Clear filters</Datum>

  <!-- ITM preset: internal article page (used for the ?dcr= fallback
       when a metaResult record has no external link authored).
       Matches the ViewPage Datum from the current About-page XSL. -->
  <Datum ID="ViewPage" Type="PageLink" Name="View Article Page (internal link fallback)"><![CDATA[$PAGE_LINK[about-us]]]></Datum>

  <!-- Lazy per-year archive loading (ITM preset).
       AvailableYears : comma-separated list of years the Year dropdown
                        should offer. Update annually as new years fill
                        in. Also add older years back to whatever depth
                        of history the RBC archive supports (currently
                        2010 onward).
       YearFeedUrlTemplate : URL template with {year} placeholder that
                             the JS substitutes when fetching a year on
                             demand. Points at the existing RBCCM per
                             year XML archive.
       The main MetaQueryExternal below still seeds the DOM with the
       most recent 200 items (the current year, effectively). When the
       user selects an older year from the dropdown, JS fetches that
       year's archive from the template URL, parses the news nodes,
       injects <li> items, and the filter engine surfaces them. -->
  <Datum ID="AvailableYears" Type="String" Name="Year dropdown values (comma separated)">2026,2025,2024,2023,2022,2021,2020,2019,2018,2017,2016,2015,2014,2013,2012,2011,2010</Datum>
  <!-- The base /en/about-us/data/{year} endpoint hard-caps at 150 items
       and returns most-recent-first, so high-volume years only reach
       back to July/August. Appending ?qPagesize=500 lifts the cap and
       returns the entire year (359 items for 2025, e.g.). -->
  <Datum ID="YearFeedUrlTemplate" Type="String" Name="Per year archive URL template (use {year})">/en/about-us/data/{year}?qPagesize=500</Datum>

  <!-- Sidecar asset paths + cache buster.
       The XSL emits a <link> for CssPath at the top of the rendered
       output and a <script> for JsPath at the bottom. Both get
       ?v=<CacheVersion> appended so a fresh publish forces browsers
       to pull the new file instead of a cached one. Bump CacheVersion
       after every deploy of the sidecar CSS or JS. -->
  <Datum ID="CssPath" Type="String" Name="Sidecar CSS path">/assets/rbccm/css/components/filtered-content.css</Datum>
  <Datum ID="JsPath" Type="String" Name="Sidecar JS path">/assets/rbccm/js/components/filtered-content.js</Datum>
  <Datum ID="CacheVersion" Type="String" Name="Cache buster (bump after each sidecar deploy)">2026-09-05</Datum>

  <!--
    Data block populated at publish time by the MetaQueryExternal
    when the ITM preset is selected. Ignored for CI/Deals presets
    (their JS adapters fetch on page load).

    Query widening vs. the About page:
      OLD (About page):
        TeamSite/Templating/DCR/Type:article/news
        AND TeamSite/Metadata/publishdate greater than 2015 00 00
        then XSL filters OUT topic='press'

      NEW (this component, ITM preset):
        TeamSite/Templating/DCR/Type:article/news
        AND TeamSite/Metadata/publishdate greater than 2015 00 00
        (NO topic filter, press releases included)

    If press releases live under a different DCR type in TeamSite
    (e.g. article/press release rather than article/news with
    topic=press), broaden the qQuery to an OR:
      (TeamSite/Templating/DCR/Type:article/news
       OR TeamSite/Templating/DCR/Type:article/press release)
      AND TeamSite/Metadata/publishdate greater than 2015 00 00
  -->
  <External>
    <Parameters>
      <Datum ID="qQuery" Name="qQuery" Type="String" Label="Query">TeamSite/Templating/DCR/Type:article/news AND TeamSite/Metadata/publishdate:&gt;2015-00-00</Datum>
      <Datum ID="qSort"     Name="qSort"     Type="String" Label="Sort">-TeamSite/Metadata/publishdate</Datum>
      <Datum ID="qPagesize" Name="qPagesize" Type="String" Label="Maximum Items">200</Datum>
      <Datum ID="qOffset"   Name="qOffset"   Type="String" Label="Offset">0</Datum>
    </Parameters>
    <Object Scope="local">com.rbccm.livesite.external.core.MetaQueryExternal</Object>
    <Method>findByQuery</Method>
  </External>

</Data>
