node_modules/
rbccm-global/dist/rbccm-global-bundle/

# macOS Finder folder settings (any folder, any depth)
.DS_Store

# Invoicing files (kept local, not in the repo)
invoices/

# Editor lock files (any folder, any depth)
.~lock*

# Local preview that embeds unpublished deals (never commit)
