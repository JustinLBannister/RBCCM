<!--
  RBCCM Hero - Properties + Data
  ==============================================================
  Preset-driven hero component. The Preset Datum picks the
  variant; each variant has its own set of content Datums that
  live in the same file. Unused Datums for a given preset are
  ignored by the XSL (matches the tabbed-panels + filtered-content
  pattern).

  Presets:
    maas-mata               Centred hero with eyebrow, 2-line
                            title (line 2 flips to blue), subtitle,
                            and up to 2 CTA buttons.
    strategy-and-economics  Split 2-column band with title + body
                            on the left, a dark navy "latest
                            insight" card on the right, and an
                            optional Brightcove video backdrop.

  SEMANTIC TAG PICKER PATTERN
  ==============================================================
  Every editable text field ships as a pair:
    <Field>Text       String / Textarea with the copy itself
    <Field>Tag        Enum picker: h1 | h2 | h3 | h4 | h5 | h6
                                 | p  | div | span
  The XSL emits the tag dynamically via xsl:element name="{tag}",
  so an author can promote an eyebrow to <h1> for SEO, drop a
  visual title to a <p> to keep it out of the outline, etc. Each
  field defaults to the semantically-neutral choice used in the
  local preview HTML.

  Sidecar assets are loaded from paths declared below and cache-
  busted via ?v={CacheVersion} appended by the XSL. See the
  "Last updated" Datum at the top of the Data block - editors
  bump it after each content save and it doubles as the cache
  buster.
-->
<Properties ComponentID="rbccm-hero">
</Properties>

<Data>

  <!-- ============================================================
       Last updated
       ============================================================
       Bump this timestamp every time you save content changes to
       this section. Format: YYYY-MM-DD-HHMM (24-hour clock).
       - Serves as a human record of when the section was last
         touched (visible at a glance to the next editor).
       - Also appended to the sidecar CSS + JS URLs as ?v={...}
         so browsers refetch the latest assets after a deploy.
       Example: 2026-09-12-1934  =  Sep 12 2026 at 7:34 PM
       ============================================================ -->
  <Datum ID="CacheVersion" Type="String" Name="Last updated (bump each time you save content - format: YYYY-MM-DD-HHMM, e.g. 2026-09-12-1934)">2026-09-12-1934</Datum>

  <!-- ============================================================
       Section identity + shared meta
       ============================================================
       What editors set here: nothing. Deploy-time plumbing.
       ============================================================ -->
  <Datum ID="SectionID" Type="String" Name="Section ID (technical - set once at deploy, editors don't change)">rbccm-hero-1</Datum>
  <Datum ID="SectionAriaLabel" Type="String" Name="Section ARIA label (technical - set once at deploy, editors don't change)">Page hero</Datum>

  <!-- Sidecar CSS path. The XSL emits a <link> for CssPath at the
       top of the rendered output with ?v={CacheVersion} appended
       (see the "Last updated" Datum at the top of the block). -->
  <Datum ID="CssPath" Type="String" Name="Sidecar CSS path (technical - set once at deploy, editors don't change)">/assets/rbccm/css/components/rbccm-hero.css</Datum>

  <!-- rbccm-button.css is the shared pill-button system used by the
       MAAS+MATA preset's CTA row. Loaded from the same convention
       and cache-busted with the same version stamp. Leave blank to
       skip the button stylesheet include (a page that already loads
       it does not need the hero to load it again). -->
  <Datum ID="ButtonCssPath" Type="String" Name="Shared button CSS path (technical - blank skips the include when page already loads it)">/assets/rbccm/css/components/rbccm-button.css</Datum>

  <!-- rbccm-hero.js hydrates the Strategy and Economics insight card
       from the RBCCM insights XML feeds when SeInsightSource is
       auto-latest. Only emitted for that preset. Blank = skip (use
       the MAAS+MATA preset without JS, or hydrate elsewhere). -->
  <Datum ID="JsPath" Type="String" Name="Sidecar JS path : S+E hydrator (technical - blank skips the include)">/assets/rbccm/js/components/rbccm-hero.js</Datum>

  <!--
    Preset selector - picks which variant this instance renders as.
    Each preset consumes its own Datum sub-set below (Mm* for
    MAAS+MATA, Se* for Strategy and Economics); unused Datums are
    ignored. Once a preset is picked, only that variant's Datums
    render - unused Datums for other presets are ignored. Bare text
    after the closing Option is the default.
  -->
  <Datum ID="Preset" Type="SelectSingle" Name="Preset - component variant (required - pick one)">
    <Option>
      <Display>MAAS + MATA (centred, glow halo, 2-line title, dual CTA)</Display>
      <Value>maas-mata</Value>
    </Option>
    <Option>
      <Display>Strategy and Economics (split column with insight card + optional video bg)</Display>
      <Value>strategy-and-economics</Value>
    </Option>
    maas-mata
  </Datum>

  <!-- Header alignment. left = base (no modifier); center adds the
       .rbccm-hero__header-center modifier that centers the hero's
       lede column (title / body for S+E, or the whole content stack
       for MAAS+MATA). Editors flip in TeamSite; left is the default
       so first-run pages ship left-aligned. Note: MAAS+MATA preset
       ships its own centered identity via its variant CSS (glow halo,
       centered eyebrow underline, single-column stack) and is not
       untangled by this Datum. Flipping to center here layers a
       text-align on top; flipping to left leaves the variant's
       inherent center layout untouched. (Class name uses __ in place
       of the BEM double-hyphen modifier so this XML comment stays
       well-formed; emitted markup uses the double-hyphen prefix.) -->
  <Datum ID="HeaderAlignment" Type="SelectSingle" Name="Header alignment (optional - controls how the hero content stack is aligned)">
    <Option Selected="true"><Display>Left</Display><Value>left</Value></Option>
    <Option><Display>Center</Display><Value>center</Value></Option>
    left
  </Datum>


  <!-- ============================================================
       MAAS + MATA preset Datums
       ============================================================
       What editors set here: the eyebrow, 2-line title, subtitle,
       and up to two CTA buttons for the MAAS+MATA hero. Only
       rendered when Preset = maas-mata; ignored otherwise.
       .............................................................
       All IDs prefixed with "Mm" so they never collide with the
       Strategy and Economics preset. Structure mirrors the local
       preview markup:

         section.rbccm-hero.rbccm-hero__maas-mata
           .rbccm-hero__container
             <MmEyebrowTag>  MmEyebrowText           </MmEyebrowTag>
             <MmTitleTag>
               <span>       MmTitleLine1Text        </span>
               <span>       MmTitleLine2Text        </span>
             </MmTitleTag>
             <MmSubtitleTag> MmSubtitleText          </MmSubtitleTag>
             <div class="rbccm-hero__actions">
               <a> MmCta1Label + icon </a>
               <a> MmCta2Label + icon </a>
             </div>

       (Class names in this comment use __ substitution for the BEM
       modifier so the XML comment stays well-formed.)
       ============================================================ -->

  <!-- Eyebrow. In production maas-mata authors this as an H1 for
       SEO; the visual "title" below stays a paragraph. -->
  <Datum ID="MmEyebrowText" Type="String" Name="MAAS+MATA : eyebrow text (required - do not blank)">Multi-Asset Agency Solutions</Datum>
  <Datum ID="MmEyebrowTag" Type="SelectSingle" Name="MAAS+MATA : eyebrow tag (optional - controls the HTML tag for SEO / a11y)">
