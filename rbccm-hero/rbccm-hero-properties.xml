    <Option><Display>h2</Display><Value>h2</Value></Option>
    <Option><Display>h3</Display><Value>h3</Value></Option>
    <Option><Display>h4</Display><Value>h4</Value></Option>
    <Option><Display>h5</Display><Value>h5</Value></Option>
    <Option><Display>h6</Display><Value>h6</Value></Option>
    <Option><Display>p</Display><Value>p</Value></Option>
    <Option><Display>div</Display><Value>div</Value></Option>
    <Option><Display>span</Display><Value>span</Value></Option>
    h1
  </Datum>

  <!-- Title outer wrapper. Inner lines are always <span>s (visual
       line breaks). Tag picker controls only the wrapper element. -->
  <Datum ID="MmTitleLine1Text" Type="String" Name="MAAS+MATA : title line 1 - dark navy (required - do not blank)">Trade with clarity.</Datum>
  <Datum ID="MmTitleLine2Text" Type="String" Name="MAAS+MATA : title line 2 - bright blue (required - do not blank)">Execute with control.</Datum>
  <Datum ID="MmTitleTag" Type="SelectSingle" Name="MAAS+MATA : title wrapper tag (optional - controls the HTML tag for SEO / a11y)">
    <Option><Display>h1</Display><Value>h1</Value></Option>
    <Option><Display>h2</Display><Value>h2</Value></Option>
    <Option><Display>h3</Display><Value>h3</Value></Option>
    <Option><Display>h4</Display><Value>h4</Value></Option>
    <Option><Display>h5</Display><Value>h5</Value></Option>
    <Option><Display>h6</Display><Value>h6</Value></Option>
    <Option><Display>p</Display><Value>p</Value></Option>
    <Option><Display>div</Display><Value>div</Value></Option>
    <Option><Display>span</Display><Value>span</Value></Option>
    p
  </Datum>

  <!-- Subtitle. Supports inline HTML (strong, em, br) so authors
       can emphasise a phrase. XSL uses disable-output-escaping so
       markup survives. -->
  <Datum ID="MmSubtitleText" Type="Textarea" Name="MAAS+MATA : subtitle (optional - blank hides the subtitle; HTML allowed)">RBC Capital Markets' &lt;strong&gt;multi-asset trading platform&lt;/strong&gt; is the only solution that keeps intelligence connected from decision to action.</Datum>
  <Datum ID="MmSubtitleTag" Type="SelectSingle" Name="MAAS+MATA : subtitle tag (optional - controls the HTML tag for SEO / a11y)">
    <Option><Display>h1</Display><Value>h1</Value></Option>
    <Option><Display>h2</Display><Value>h2</Value></Option>
    <Option><Display>h3</Display><Value>h3</Value></Option>
    <Option><Display>h4</Display><Value>h4</Value></Option>
    <Option><Display>h5</Display><Value>h5</Value></Option>
    <Option><Display>h6</Display><Value>h6</Value></Option>
    <Option><Display>p</Display><Value>p</Value></Option>
    <Option><Display>div</Display><Value>div</Value></Option>
    <Option><Display>span</Display><Value>span</Value></Option>
    p
  </Datum>

  <!-- CTA 1. Blank Label hides the button entirely. Style picks
       one of the rbccm-button variants. Icon slot is a raw SVG
       path payload (author pastes the "d" attribute contents),
       so any Figma icon can drop in without editing the XSL. -->
  <Datum ID="MmCta1Label" Type="String" Name="MAAS+MATA : CTA 1 label (optional - blank hides the button)">Request a demo</Datum>
  <Datum ID="MmCta1Href" Type="String" Name="MAAS+MATA : CTA 1 URL (required if label is set - full URL or /en/ path)">#</Datum>
