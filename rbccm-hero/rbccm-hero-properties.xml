  <Datum ID="MmCta2Title" Type="String" Name="MAAS+MATA : CTA 2 title attribute / tooltip (optional - blank hides the tooltip)"></Datum>
  <Datum ID="MmCta2Style" Type="SelectSingle" Name="MAAS+MATA : CTA 2 style (optional - controls the button variant)">
