  <Datum ID="MmCta2IconViewBox" Type="String" Name="MAAS+MATA : CTA 2 SVG viewBox (optional - blank defaults to '0 0 24 24')">0 0 24 24</Datum>


  <!-- ============================================================
       Strategy and Economics preset Datums
       ============================================================
       What editors set here: the left-column lede (title + body)
       and the right-column insight card (eyebrow, title, body,
       date, link) for the S+E hero. Only rendered when Preset =
       strategy-and-economics; ignored otherwise. Technical config
       (video backdrop + hydrator source) sits at the bottom.
       .............................................................
       All IDs prefixed with "Se". Datums are ordered to match the
       rendered DOM (top-to-bottom, left-to-right):

         1. Lede column (visible top-left content):
            SeTitle*, SeBody*
         2. Insight card (visible right column, top-to-bottom):
            SeInsightEyebrow*, SeInsightTitle*, SeInsightBody*,
            SeInsightDate*, SeInsightLink*
         3. Background video config (behind-content technical):
            SeBgBrightcove*
         4. Insight card sourcing + hydrator config (behind-content
            technical):
            SeInsightSource, SeInsightDcr, SeInsightDcrLink,
            SeInsightFeedUrls, SeInsightTagKeywords,
            SeInsightPinnedUrl, SeInsightAutoLinkOverride

         section.rbccm-hero.rbccm-hero__strategy-and-economics
           .rbccm-hero__bg-video       (Brightcove iframe if VideoId set)
           .rbccm-hero__blur           (desktop-only decorative ellipse)
           .rbccm-hero__container
             .rbccm-hero__grid
               .rbccm-hero__lede
                 <SeTitleTag>   SeTitleText   </SeTitleTag>
                 <SeBodyTag>    SeBodyText    </SeBodyTag>
               .rbccm-hero__insight-card
                 .rbccm-hero__insight-eyebrow-row
                   .rbccm-hero__insight-eyebrow-inner
                     <SeInsightEyebrowTag> SeInsightEyebrowText </...>
                 <SeInsightTitleTag> SeInsightTitleText </...>
                 <SeInsightBodyTag>  SeInsightBodyText  </...>
                 <footer .rbccm-hero__insight-footer>
                   <SeInsightDateTag> SeInsightDateText </...>
                   <a class="rbccm-hero__insight-link">
                     SeInsightLinkLabel + arrow SVG
                   </a>
       ============================================================ -->

