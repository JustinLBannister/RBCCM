<!--
  RBCCM Hero - Properties + Data
  ==============================================================
  One Properties file shared by the three hero skins. The skin
  picked in TeamSite's Skin dropdown decides the variant:

    rbccm-hero (double-dash) maas-mata.xsl               MAAS+MATA
    rbccm-hero (double-dash) strategy-and-economics.xsl  Strategy and Economics
    rbccm-hero (double-dash) us-credentials.xsl          US Credentials

  Each field's label says which variants use it. A skin ignores
  fields it doesn't use.

  Where fields live (TeamSite tabs):
    Properties / Appearance   paths, IDs, alignment, tag pickers,
                              button style + icon, Brightcove
                              account/player, S+E body width,
                              locale, feed URLs
    Data / Content            eyebrow / title / subtitle copy,
                              background video, button labels +
                              links, S+E insight card + sourcing

  Tag pickers
  ==============================================================
  Tag fields choose the HTML element for SEO / a11y. "Auto" (the
  default) uses each variant's own default:
    MAAS+MATA       eyebrow h1, title p,  subtitle p
    S+E             title h1,   body p   (insight title: always h2)
    US Credentials  eyebrow h1, title p,  subtitle p

  Legacy field IDs (2026-09 cleanup)
  ==============================================================
  The shared fields replaced per-variant copies. For pages saved
  before the cleanup, each skin falls back to the old ID when the
  new field is blank (or a tag is on Auto), so nothing goes
  missing:

    EyebrowText / EyebrowTag    MmEyebrow*, UcEyebrow*
    TitleLine1Text              MmTitleLine1Text, UcTitleLine1Text, SeTitleText
    TitleLine2Text              MmTitleLine2Text, UcTitleLine2Text
    TitleTag                    MmTitleTag, UcTitleTag, SeTitleTag
    SubtitleText / SubtitleTag  MmSubtitle*, UcSubtitle*, SeBody*
    Bg* (4 fields)              SeBg*, UcBg*
    MmCta1Icon / MmCta2Icon     MmCta*IconPath + MmCta*IconViewBox
    (removed, fixed tags)       SeInsightEyebrowTag p, SeInsightTitleTag h2,
                                SeInsightBodyTag p, SeInsightDateTag span

  Once every hero page has been re-saved, the fallbacks can be
  deleted from the skins.

  Sidecar assets are cache-busted via ?v={CacheVersion}.
-->
<Properties ComponentID="rbccm-hero">

  <!-- ============================================================
       Appearance tab: settings, paths, layout, tags, colours
       ============================================================ -->

  <!-- Bump on every content save. Doubles as the ?v= cache buster
       on the sidecar CSS / JS URLs. Format YYYY-MM-DD-HHMM. -->
  <Datum ID="CacheVersion" Type="String" Name="Last updated (bump each time you save content - format: YYYY-MM-DD-HHMM, e.g. 2026-09-12-1934)">2026-09-12-1934</Datum>

  <Datum ID="SectionID" Type="String" Name="Section ID (technical - set once at deploy)">rbccm-hero-1</Datum>

  <Datum ID="SectionAriaLabel" Type="String" Name="Section ARIA label (technical - set once at deploy)">Page hero</Datum>

  <Datum ID="CssPath" Type="String" Name="Hero CSS path (technical - set once at deploy)">/assets/rbccm/css/components/rbccm-hero.css</Datum>

  <!-- MAAS+MATA only (its buttons). Blank skips the include when the
       page already loads rbccm-button.css. -->
  <Datum ID="ButtonCssPath" Type="String" Name="Button CSS path : MAAS+MATA (technical - blank skips the include)">/assets/rbccm/css/components/rbccm-button.css</Datum>

  <!-- S+E only: insight card hydrator (auto-latest / pinned URL). -->
  <Datum ID="JsPath" Type="String" Name="Hero JS path : S+E insight card (technical - blank skips the include)">/assets/rbccm/js/components/rbccm-hero.js</Datum>

  <!-- Left = base. Center adds the header-center modifier. MAAS+MATA
       is centred by design either way. -->
  <Datum ID="HeaderAlignment" Type="SelectSingle" Name="Header alignment (optional)">
    <Option Selected="true"><Display>Left</Display><Value>left</Value></Option>
    <Option><Display>Center</Display><Value>center</Value></Option>
    left
  </Datum>

  <Datum ID="EyebrowTag" Type="SelectSingle" Name="Eyebrow tag (optional - Auto = h1)">
    <Option Selected="true"><Display>Auto (variant default)</Display><Value>auto</Value></Option>
    <Option><Display>h1</Display><Value>h1</Value></Option>
    <Option><Display>h2</Display><Value>h2</Value></Option>
    <Option><Display>h3</Display><Value>h3</Value></Option>
    <Option><Display>h4</Display><Value>h4</Value></Option>
    <Option><Display>h5</Display><Value>h5</Value></Option>
    <Option><Display>h6</Display><Value>h6</Value></Option>
    <Option><Display>p</Display><Value>p</Value></Option>
    <Option><Display>div</Display><Value>div</Value></Option>
    <Option><Display>span</Display><Value>span</Value></Option>
    auto
  </Datum>

  <Datum ID="TitleTag" Type="SelectSingle" Name="Title tag (optional - Auto = p, or h1 on S+E)">
    <Option Selected="true"><Display>Auto (variant default)</Display><Value>auto</Value></Option>
    <Option><Display>h1</Display><Value>h1</Value></Option>
    <Option><Display>h2</Display><Value>h2</Value></Option>
    <Option><Display>h3</Display><Value>h3</Value></Option>
    <Option><Display>h4</Display><Value>h4</Value></Option>
    <Option><Display>h5</Display><Value>h5</Value></Option>
    <Option><Display>h6</Display><Value>h6</Value></Option>
    <Option><Display>p</Display><Value>p</Value></Option>
    <Option><Display>div</Display><Value>div</Value></Option>
    <Option><Display>span</Display><Value>span</Value></Option>
    auto
  </Datum>

  <Datum ID="SubtitleTag" Type="SelectSingle" Name="Subtitle tag (optional - Auto = p)">
    <Option Selected="true"><Display>Auto (variant default)</Display><Value>auto</Value></Option>
    <Option><Display>h1</Display><Value>h1</Value></Option>
    <Option><Display>h2</Display><Value>h2</Value></Option>
    <Option><Display>h3</Display><Value>h3</Value></Option>
    <Option><Display>h4</Display><Value>h4</Value></Option>
    <Option><Display>h5</Display><Value>h5</Value></Option>
    <Option><Display>h6</Display><Value>h6</Value></Option>
    <Option><Display>p</Display><Value>p</Value></Option>
    <Option><Display>div</Display><Value>div</Value></Option>
    <Option><Display>span</Display><Value>span</Value></Option>
    auto
  </Datum>

  <Datum ID="BgBrightcoveAccount" Type="String" Name="Brightcove account ID (technical - RBC-wide constant)">6021289101001</Datum>

  <Datum ID="BgBrightcovePlayer" Type="String" Name="Brightcove player ID (technical - RBC-wide constant)">VyvCc9BZx</Datum>

  <Datum ID="MmCta1Style" Type="SelectSingle" Name="MAAS+MATA : button 1 style">
    <Option Selected="true"><Display>Primary (blue fill)</Display><Value>primary</Value></Option>
    <Option><Display>Secondary (outlined)</Display><Value>secondary</Value></Option>
    <Option><Display>Yellow (warm-yellow fill)</Display><Value>yellow</Value></Option>
    <Option><Display>Ghost (dark-strip)</Display><Value>ghost</Value></Option>
    primary
  </Datum>

  <Datum ID="MmCta1Icon" Type="SelectSingle" Name="MAAS+MATA : button 1 icon">
    <Option Selected="true"><Display>Arrow</Display><Value>arrow</Value></Option>
    <Option><Display>Play</Display><Value>play</Value></Option>
    <Option><Display>None</Display><Value>none</Value></Option>
    arrow
  </Datum>

  <Datum ID="MmCta2Style" Type="SelectSingle" Name="MAAS+MATA : button 2 style">
    <Option><Display>Primary (blue fill)</Display><Value>primary</Value></Option>
    <Option Selected="true"><Display>Secondary (outlined)</Display><Value>secondary</Value></Option>
    <Option><Display>Yellow (warm-yellow fill)</Display><Value>yellow</Value></Option>
    <Option><Display>Ghost (dark-strip)</Display><Value>ghost</Value></Option>
    secondary
  </Datum>

  <Datum ID="MmCta2Icon" Type="SelectSingle" Name="MAAS+MATA : button 2 icon">
    <Option><Display>Arrow</Display><Value>arrow</Value></Option>
    <Option Selected="true"><Display>Play</Display><Value>play</Value></Option>
    <Option><Display>None</Display><Value>none</Value></Option>
    play
  </Datum>

  <!-- Optional desktop max-width on the S+E body paragraph (widow control).
       Applied only at the desktop breakpoint (>= 992px); mobile / tablet
       always render at 100% column width. Blank falls back to 100%.
       Any CSS length unit works (%, px, rem, ch). -->
  <Datum ID="SeBodyMaxWidth" Type="String" Name="S+E : body max-width at desktop e.g. '86%' (optional - blank inherits 100%)">86%</Datum>

  <!-- Locale hint passed to the hydrator via data-hero-locale. Only
       'en' and 'fr' are recognized; unknown values coerce to 'en'.
       Reserved for future localisation of the insight card copy. -->
  <Datum ID="SeLocale" Type="SelectSingle" Name="S+E : locale for the insight card hydrator (optional - defaults to English)">
    <Option><Display>English (en)</Display><Value>en</Value></Option>
    <Option><Display>French (fr)</Display><Value>fr</Value></Option>
    en
  </Datum>

  <!-- Comma-separated list of insights XML feed URLs the hydrator
       walks. Default covers 2024/2025/2026 - update once a year
       when a new year feed goes live (or every year in bulk). -->
  <Datum ID="SeInsightFeedUrls" Type="String" Name="S+E : feed URLs (required in auto-latest mode; comma-separated)">https://www.rbccm.com/en/insights/data/2024-insights,https://www.rbccm.com/en/insights/data/2025-insights,https://www.rbccm.com/en/insights/data/2026-insights</Datum>

</Properties>

<Data>

  <!-- ============================================================
       Content tab: copy, links, media
       ============================================================ -->

  <Datum ID="EyebrowText" Type="String" Name="Eyebrow : MAAS+MATA, US Creds (optional - blank hides it)"></Datum>

  <Datum ID="TitleLine1Text" Type="String" Name="Title line 1 : all variants (required)"></Datum>

  <Datum ID="TitleLine2Text" Type="String" Name="Title line 2, accent colour : MAAS+MATA, US Creds (optional)"></Datum>

  <!-- HTML allowed (strong, em, br); rendered unescaped. -->
  <Datum ID="SubtitleText" Type="Textarea" Name="Subtitle / body copy : all variants (optional - blank hides it; HTML allowed)"></Datum>

  <Datum ID="BgVideoMp4" Type="String" Name="Background MP4 URL (optional - overrides Brightcove if set)"></Datum>

  <Datum ID="BgBrightcoveVideoId" Type="String" Name="Brightcove video ID (optional)"></Datum>

  <Datum ID="MmCta1Label" Type="String" Name="MAAS+MATA : button 1 label (optional - blank hides the button)">Request a demo</Datum>

  <Datum ID="MmCta1Href" Type="String" Name="MAAS+MATA : button 1 URL (required if label is set - full URL or /en/ path)">#</Datum>

  <Datum ID="MmCta1AriaLabel" Type="String" Name="MAAS+MATA : button 1 accessible name (optional - screen-reader label)"></Datum>

  <Datum ID="MmCta1Title" Type="String" Name="MAAS+MATA : button 1 tooltip (optional - blank hides the tooltip)"></Datum>

  <Datum ID="MmCta2Label" Type="String" Name="MAAS+MATA : button 2 label (optional - blank hides the button)">Watch the video</Datum>

  <Datum ID="MmCta2Href" Type="String" Name="MAAS+MATA : button 2 URL (required if label is set - full URL or /en/ path)">#</Datum>

  <Datum ID="MmCta2AriaLabel" Type="String" Name="MAAS+MATA : button 2 accessible name (optional - screen-reader label)"></Datum>

  <Datum ID="MmCta2Title" Type="String" Name="MAAS+MATA : button 2 tooltip (optional - blank hides the tooltip)"></Datum>

  <!-- Insight card: pill eyebrow + title + body + footer (date + link). -->
  <Datum ID="SeInsightEyebrowText" Type="String" Name="S+E : insight card eyebrow / pill label (required - do not blank)">Latest Insight</Datum>

  <Datum ID="SeInsightTitleText" Type="String" Name="S+E : insight card title (required - do not blank; used as fallback in auto-latest mode)">The Tariff Fog: How Supply-Side Shocks Are Reshaping Canada's Export Calculus</Datum>

  <Datum ID="SeInsightBodyText" Type="Textarea" Name="S+E : insight card body (required - do not blank; HTML allowed; used as fallback in auto-latest mode)">With U.S. tariffs covering 38% of Canadian exports, RBC economists model three divergent recovery paths through 2026.</Datum>

  <Datum ID="SeInsightDateText" Type="String" Name="S+E : insight card date (optional - blank hides the date; overridden in auto-latest mode)">July 14, 2025</Datum>

  <!-- Link is always an anchor tag (it needs an href to work). The
       label text renders inside a <span>, so no tag picker here.
       In auto-latest mode the LinkLabel is still used (label text
       stays constant across articles); LinkHref is overridden by
       the feed record's URL unless SeInsightAutoLinkOverride is set. -->
  <Datum ID="SeInsightLinkLabel" Type="String" Name="S+E : insight card link label (required - do not blank)">Read more</Datum>

  <Datum ID="SeInsightLinkHref" Type="String" Name="S+E : insight card link URL - manual mode only (optional - full URL or /en/ path; auto-latest overrides this)">#</Datum>

  <Datum ID="SeInsightLinkAriaLabel" Type="String" Name="S+E : insight card link accessible name (optional - screen-reader label for the link)"></Datum>

  <!-- Insight card source. Three modes:
         dcr-picker   editor picks the insights article via TeamSite's
                      native DCR picker (SeInsightDcr below). The XSL
                      renders the card server-side from the selected
                      DCR record. Non-blank SeInsight* Datums above
                      act as per-field overrides (story-tile pattern).
                      In `dcr-picker` mode, if `SeInsightPinnedUrl` is
                      set the runtime uses that URL to look up the
                      article in the feed instead of the picked DCR -
                      a safety net for pages where DCR publishing is
                      unreliable.
         auto-latest  hydrated client-side by rbccm-hero.js from the
                      RBCCM insights XML feeds listed in SeInsightFeedUrls.
                      The SeInsight* Datums render server-side as the
                      pre-hydration fallback that shows while the feed
                      loads (and as the no-JS fallback).
         manual       always uses the S+E insight card fields above; fully
                      server-rendered, no client hydration. -->
  <Datum ID="SeInsightSource" Type="SelectSingle" Name="S+E : insight card source (required - pick one; controls how the card is populated)">
    <Option Selected="true">
      <Display>DCR picker - editor picks the article via TeamSite (server-rendered)</Display>
      <Value>dcr-picker</Value>
    </Option>
    <Option>
      <Display>Auto - latest Strategy and Economics article from feed (client-hydrated)</Display>
      <Value>auto-latest</Value>
    </Option>
    <Option>
      <Display>Manual - always use the S+E insight card fields above</Display>
      <Value>manual</Value>
    </Option>
    dcr-picker
  </Datum>

  <!-- DCR picker source + companion CTA URL. Only read when
       SeInsightSource=dcr-picker. Type="DCR" surfaces TeamSite's
       native article picker; the allowed categories/types below
       mirror the story-tiles picker (any Insights article, plus
       rbccm/episode, rbccm/imagine2025, rbccm/casestudy). Because
       multiple types are allowed, the XSL wildcards the DCR
       wrapper element name (Datum/DCR/*/{field}) rather than
       hardcoding a single type.

       SeInsightDcrLink is a sibling CTA URL that pairs with the
       picked DCR (mirrors the story-tiles pattern where Link is a
       sibling Datum, not a field on the DCR record). Blank = the
       XSL falls back to the DCR record's own link/url field. -->
  <Datum ID="SeInsightDcr" Type="DCR" Name="S+E : insight card DCR - dcr-picker mode only (required if mode is DCR picker)">
    <DCR Category="article" Type="insights"/>
    <DCR-Category Name="article">
      <DCR-Type Name=".*"/>
    </DCR-Category>
    <DCR-Category Name="rbccm">
      <DCR-Type Name="episode"/>
      <DCR-Type Name="imagine2025"/>
      <DCR-Type Name="casestudy"/>
    </DCR-Category>
  </Datum>

  <Datum ID="SeInsightDcrLink" Type="String" Name="S+E : insight card CTA URL - dcr-picker mode (optional - blank derives from the picked DCR)"></Datum>

  <!-- Comma-separated list of tag keywords. rbccm-hero.js checks each
       feed record's &lt;tags&gt; field for a case-insensitive substring
       match against any keyword; a record survives the filter as
       long as AT LEAST ONE keyword hits. Newest surviving record
       wins. RBCCM's insights feed doesn't ship a top-level S+E
       category, so this keyword set is how we hand-carve the topic
       out of the general Insights firehose. Tune as taxonomy evolves.
       Ignored when SeInsightPinnedUrl is set. -->
  <Datum ID="SeInsightTagKeywords" Type="String" Name="S+E : tag keywords - any-match (optional in auto-latest mode; comma-separated; ignored when a pinned URL is set)">economic,strategy,macro,geopolitics,monetary,inflation</Datum>

  <!-- Pin-by-URL. Paste a specific article URL (either the full
       https URL or the /en/ path) and the hydrator will look up
       THAT record in the feeds by URL match and use its title /
       description / date / link. Serves two roles depending on
       the mode picked in SeInsightSource:

         auto-latest  Overrides the keyword search entirely -
                      useful when editorial wants a specific piece
                      featured regardless of what's newest. Blank
                      here means "fall back to keyword-based
                      auto-latest".

         dcr-picker   Acts as a safety net for pages where the
                      TeamSite DCR publishing pipeline is broken.
                      When set, the runtime looks up the article
                      in the feed by URL and hydrates the card
                      from that record - overwriting the DCR-
                      rendered (or empty) content. If the URL
                      doesn't match a feed record the DCR-rendered
                      fallback stays in place. Blank here means
                      "trust the DCR picker; no client hydration".

       In both modes the URL is matched against feed records by
       final slug, so the full https URL and the /en/ path are
       treated as the same article. -->
  <Datum ID="SeInsightPinnedUrl" Type="String" Name="S+E : pin a specific article URL (optional - full URL or /en/ path; auto-latest override + dcr-picker fallback)"></Datum>

  <!-- Optional CTA link override for auto-latest mode. Blank uses
       the feed record's own article URL. Editorial sometimes wants
       "Read more" to point at a hub page instead of the article. -->
  <Datum ID="SeInsightAutoLinkOverride" Type="String" Name="S+E : auto-mode link override (optional - blank uses the feed URL)"></Datum>

</Data>
