    <Option><Display>Primary (blue fill)</Display><Value>primary</Value></Option>
    <Option><Display>Secondary (outlined)</Display><Value>secondary</Value></Option>
    <Option><Display>Yellow (warm-yellow fill)</Display><Value>yellow</Value></Option>
    <Option><Display>Ghost (dark-strip)</Display><Value>ghost</Value></Option>
    primary
  </Datum>
  <Datum ID="MmCta1IconPath" Type="String" Name="MAAS+MATA : CTA 1 SVG path 'd' payload (optional - blank skips the icon slot)">M13.293 5.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L17.586 13H4a1 1 0 110-2h13.586l-4.293-4.293a1 1 0 010-1.414z</Datum>
