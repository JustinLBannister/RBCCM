<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample DCR payload for previewing the hero skins against real data.
  Not shipped. Run any of the three skins against this file with an
  XSLT 1.0 tool (xsltproc, lxml, etc.):

    rbccm-hero (double-dash) maas-mata.xsl
    rbccm-hero (double-dash) strategy-and-economics.xsl
    rbccm-hero (double-dash) us-credentials.xsl

  Uses the shared field IDs from rbccm-hero-properties.xml. The shared
  content below is MAAS+MATA copy; swap it to preview the others
  (S+E uses TitleLine1Text + SubtitleText only).
-->
<Properties ComponentID="rbccm-hero">
  <Data>

    <Datum ID="CacheVersion">1</Datum>
    <Datum ID="SectionID">rbccm-hero-preview</Datum>
    <Datum ID="SectionAriaLabel">Page hero</Datum>
    <Datum ID="CssPath">/assets/rbccm/css/components/rbccm-hero.css</Datum>
    <Datum ID="ButtonCssPath">/assets/rbccm/css/components/rbccm-button.css</Datum>
    <Datum ID="JsPath">/assets/rbccm/js/components/rbccm-hero.js</Datum>
    <Datum ID="HeaderAlignment">left</Datum>

    <!-- ==== Hero content (all variants) ==== -->
    <Datum ID="EyebrowText">Multi-Asset Agency Solutions</Datum>
    <Datum ID="EyebrowTag">auto</Datum>
    <Datum ID="TitleLine1Text">Trade with clarity.</Datum>
    <Datum ID="TitleLine2Text">Execute with control.</Datum>
    <Datum ID="TitleTag">auto</Datum>
    <Datum ID="SubtitleText">RBC Capital Markets' &lt;strong&gt;multi-asset trading platform&lt;/strong&gt; is the only solution that keeps intelligence connected from decision to action.</Datum>
    <Datum ID="SubtitleTag">auto</Datum>

    <!-- ==== Background video (S+E, US Creds) ==== -->
    <Datum ID="BgVideoMp4"></Datum>
    <Datum ID="BgBrightcoveVideoId"></Datum>
    <Datum ID="BgBrightcoveAccount">6021289101001</Datum>
    <Datum ID="BgBrightcovePlayer">VyvCc9BZx</Datum>

    <!-- ==== MAAS+MATA buttons ==== -->
    <Datum ID="MmCta1Label">Request a demo</Datum>
    <Datum ID="MmCta1Href">#demo</Datum>
    <Datum ID="MmCta1AriaLabel"></Datum>
    <Datum ID="MmCta1Title"></Datum>
    <Datum ID="MmCta1Style">primary</Datum>
    <Datum ID="MmCta1Icon">arrow</Datum>

    <Datum ID="MmCta2Label">Watch the video</Datum>
    <Datum ID="MmCta2Href">#video</Datum>
    <Datum ID="MmCta2AriaLabel"></Datum>
    <Datum ID="MmCta2Title"></Datum>
    <Datum ID="MmCta2Style">secondary</Datum>
    <Datum ID="MmCta2Icon">play</Datum>

    <!-- ==== Strategy and Economics ==== -->
    <Datum ID="SeBodyMaxWidth">86%</Datum>
    <Datum ID="SeInsightEyebrowText">Latest Insight</Datum>
    <Datum ID="SeInsightTitleText">The Tariff Fog: How Supply-Side Shocks Are Reshaping Canada's Export Calculus</Datum>
    <Datum ID="SeInsightTitleTag">auto</Datum>
    <Datum ID="SeInsightBodyText">With U.S. tariffs covering 38% of Canadian exports, RBC economists model three divergent recovery paths through 2026.</Datum>
    <Datum ID="SeInsightDateText">July 14, 2025</Datum>
    <Datum ID="SeInsightLinkLabel">Read more</Datum>
    <Datum ID="SeInsightLinkHref">/en/insights/strategy-and-economics/tariff-fog</Datum>
    <Datum ID="SeInsightLinkAriaLabel">Read more: The Tariff Fog</Datum>

    <Datum ID="SeInsightSource">auto-latest</Datum>
    <Datum ID="SeInsightDcrLink"></Datum>
    <Datum ID="SeLocale">en</Datum>
    <Datum ID="SeInsightFeedUrls">https://www.rbccm.com/en/insights/data/2024-insights,https://www.rbccm.com/en/insights/data/2025-insights,https://www.rbccm.com/en/insights/data/2026-insights</Datum>
    <Datum ID="SeInsightTagKeywords">economic,strategy,macro,geopolitics,monetary,inflation</Datum>
    <Datum ID="SeInsightPinnedUrl"></Datum>
    <Datum ID="SeInsightAutoLinkOverride"></Datum>

  </Data>
</Properties>
