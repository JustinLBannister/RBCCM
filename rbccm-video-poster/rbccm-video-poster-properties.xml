<!-- ============================================================
     RBCCM Video Poster  |  Properties + Data
     ============================================================
     Rounded poster image with a centred play button that opens a
     Brightcove video in a modal (the MAAS+MATA "Execution Console"
     image under the hero).

     No video ID = image only, no play button, no modal.
     Only the Brightcove video ID normally changes; account and
     player are RBC-wide constants (blank uses them).

     Deploy alongside:
       /assets/rbccm/css/components/rbccm-video-poster.css
       /assets/rbccm/js/components/rbccm-video-poster.js
     ============================================================ -->
<Properties ComponentID="rbccm-video-poster-v1">

  <!-- ============================================================
       Appearance tab: settings, paths, layout, tags, colours
       ============================================================ -->

  <Datum ID="CssPath" Type="String" Name="CSS path (technical - blank uses the default)">/assets/rbccm/css/components/rbccm-video-poster.css</Datum>

  <Datum ID="JsPath" Type="String" Name="JS path (technical - blank uses the default)">/assets/rbccm/js/components/rbccm-video-poster.js</Datum>

  <Datum ID="CacheVersion" Type="String" Name="Last updated (bump each time you save - format YYYY-MM-DD-HHMM)">2026-09-28-1200</Datum>

  <!-- Also used for the modal id (SectionID + "-modal"), so give
       each poster on a page its own value. -->
  <Datum ID="SectionID" Type="String" Name="ID (unique per page - blank = rbccm-video-poster-1)">rbccm-video-poster-1</Datum>

  <Datum ID="SpaceAbove" Type="String" Name="Space above on desktop, in px (blank = 75; mobile is always 0)">75</Datum>

  <!-- How far the next section slides up underneath the image. 200
       on MAAS+MATA; 0 for no overlap. -->
  <Datum ID="OverlapBelow" Type="String" Name="Overlap into the next section, in px (blank = 200; 0 = none)">200</Datum>

  <Datum ID="BrightcoveAccount" Type="String" Name="Brightcove account ID (RBC-wide constant - leave as is)">6021289101001</Datum>

  <Datum ID="BrightcovePlayer" Type="String" Name="Brightcove player ID (RBC-wide constant - leave as is)">VyvCc9BZx</Datum>

</Properties>

<Data>

  <!-- ============================================================
       Content tab: copy, links, media
       ============================================================ -->

