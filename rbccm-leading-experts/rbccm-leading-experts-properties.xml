  <Datum ID="Expert1NameText" Type="String" Name="Expert 1 : name (required - do not blank; blank hides the whole card)">Helima Croft</Datum>
  <Datum ID="Expert1NameTag" Type="SelectSingle" Name="Expert 1 : name tag (optional - controls the HTML tag for SEO / a11y)">
