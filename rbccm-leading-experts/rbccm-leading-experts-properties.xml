<!--
  RBCCM Leading Experts - Properties + Data
  ==============================================================
  Preset-driven three-card grid of expert profiles. Each card = a
  DAM photo behind a top-to-bottom navy gradient, with an eyebrow
  pill, name, role, and gold CTA overlaid. Fixed 3 slots; a slot
  hides entirely when its NameText Datum is blank.

  Presets:
    strategy-and-economics-leading-experts
      Light-blue section (matches S+E hero + expertise), navy card
      tiles, warm-yellow eyebrow + gold CTA, RBC Display name.

  Photo picker
  ==============================================================
  Each Expert{N}Photo is a Type="Image" Datum backed by TeamSite's
  DAM picker. The nested <Image> skeleton with empty <Path/> and
  <Description/> is REQUIRED because a previous cross-component
  attempt hit "Datum ID=[...] Value is not a valid image" when the
  skeleton was omitted (see icon-carousel-properties.xml for the
  same note). Copy the skeleton verbatim for any new photo slot.

  XSL reads two child nodes off each Photo Datum and emits a real
  <img> element inside the card:
    /Image/Path         becomes src on the <img>
    /Image/Description  becomes alt on the <img> (falls back to
                        NameText when blank so screen readers still
                        announce the person the card represents)

  Focal point (optional)
  ==============================================================
  Each Expert{N}FocalPoint is an optional String that overrides the
  CSS default object-position (50% 20%) for that card's photo. Use
  it to keep faces well-framed when a portrait's head sits higher
  or lower than average in the source image. Values are standard
  CSS object-position ("50% 15%", "60% 30%", "top center", etc.).
  Leave blank to inherit the CSS default.

  SEMANTIC TAG PICKER PATTERN
  ==============================================================
  Every editable text field ships as a pair:
    <Field>Text       String / Textarea with the copy itself
    <Field>Tag        Enum picker: h1..h6, p, div, span
  XSL emits the tag via xsl:element name="{tag}", guarded by the
  pickTag allow-list.

  CTA anchor tag is fixed at <a> (semantic requirement for links);
  only the visible CTA copy + href are Datums.
-->
<Properties ComponentID="rbccm-leading-experts">
</Properties>

<Data>

  <!-- ============================================================
       Last updated
       ============================================================
       Bump this timestamp every time you save content changes to
       this section. Format: YYYY-MM-DD-HHMM (24-hour clock).
       - Serves as a human record of when the section was last
         touched (visible at a glance to the next editor).
       - Also appended to the sidecar CSS + JS URLs as ?v={...}
         so browsers refetch the latest assets after a deploy.
       Example: 2026-09-12-1934  =  Sep 12 2026 at 7:34 PM
       ============================================================ -->
  <Datum ID="CacheVersion" Type="String" Name="Last updated (bump each time you save content - format: YYYY-MM-DD-HHMM, e.g. 2026-09-12-1934)">2026-09-12-1934</Datum>

  <!-- ============================================================
       Section identity + shared meta
       ============================================================
       What editors set here: nothing. Deploy-time plumbing.
       ============================================================ -->
  <Datum ID="SectionID" Type="String" Name="Section ID (technical - set once at deploy, editors don't change)">rbccm-leading-experts-1</Datum>
  <Datum ID="SectionAriaLabel" Type="String" Name="Section ARIA label (technical - set once at deploy, editors don't change)">Leading experts</Datum>

  <Datum ID="CssPath" Type="String" Name="Sidecar CSS path (technical - set once at deploy, editors don't change)">/assets/rbccm/css/components/rbccm-leading-experts.css</Datum>
  <Datum ID="JsPath" Type="String" Name="Sidecar JS path (technical - component has no runtime yet, leave blank)"></Datum>

  <!-- Once a preset is picked, only that variant's Datums render -
       unused Datums for other presets are ignored. -->
  <Datum ID="Preset" Type="SelectSingle" Name="Preset - component variant (required - pick one)">
    <Option>
      <Display>Strategy and Economics - Leading experts</Display>
      <Value>strategy-and-economics-leading-experts</Value>
    </Option>
    strategy-and-economics-leading-experts
  </Datum>


  <!-- ============================================================
       Section header
       ============================================================
       What editors set here: the big headline at the top of the
       section. The tag picker lets you promote the title to h2
       for SEO.
       .............................................................
       Header alignment. left = base (no modifier); center adds the
       .rbccm-leading-experts__header-center modifier that centers
       the section title. (Class name uses __ substitution for the
       BEM modifier so this XML comment stays well-formed; emitted
       markup uses the double-hyphen prefix.)
       ============================================================ -->
  <Datum ID="HeaderAlignment" Type="SelectSingle" Name="Header alignment (optional - controls how the title block is aligned)">
    <Option Selected="true"><Display>Left</Display><Value>left</Value></Option>
    <Option><Display>Center</Display><Value>center</Value></Option>
    left
  </Datum>

  <Datum ID="SectionTitleText" Type="String" Name="Section title (required - do not blank)">Leading experts</Datum>
  <Datum ID="SectionTitleTag" Type="SelectSingle" Name="Section title tag (optional - controls the HTML tag for SEO / a11y)">
    <Option><Display>h1</Display><Value>h1</Value></Option>
    <Option><Display>h2</Display><Value>h2</Value></Option>
    <Option><Display>h3</Display><Value>h3</Value></Option>
    <Option><Display>h4</Display><Value>h4</Value></Option>
    <Option><Display>h5</Display><Value>h5</Value></Option>
    <Option><Display>h6</Display><Value>h6</Value></Option>
    <Option><Display>p</Display><Value>p</Value></Option>
    <Option><Display>div</Display><Value>div</Value></Option>
    <Option><Display>span</Display><Value>span</Value></Option>
    h2
  </Datum>


