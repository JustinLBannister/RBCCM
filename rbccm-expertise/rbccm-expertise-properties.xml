  <Datum ID="Pillar1BodyText" Type="Textarea" Name="Pillar 1 : body (required - do not blank; HTML allowed)">Global political developments, energy, and their market impact.</Datum>
  <Datum ID="Pillar1BodyTag" Type="String" Name="Pillar 1 : body tag (optional - controls the HTML tag for SEO / a11y)">
    <Option><Display>h1</Display><Value>h1</Value></Option><Option><Display>h2</Display><Value>h2</Value></Option><Option><Display>h3</Display><Value>h3</Value></Option><Option><Display>h4</Display><Value>h4</Value></Option><Option><Display>h5</Display><Value>h5</Value></Option><Option><Display>h6</Display><Value>h6</Value></Option><Option><Display>p</Display><Value>p</Value></Option><Option><Display>div</Display><Value>div</Value></Option><Option><Display>span</Display><Value>span</Value></Option>p</Datum>

