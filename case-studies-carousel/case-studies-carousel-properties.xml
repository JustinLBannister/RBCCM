<!-- ============================================================
     Case Studies Carousel - Properties + Data
     ============================================================
     URL-driven schema (v2). Replaces the earlier DCR-picker
     approach that hung TeamSite's publish walk. Authors paste
     the public URL of a case study - the runtime JS fetches the
     shared case-studies feed
       /en/expertise/transactions/data/case-studies.page
     matches each slide's URL to a feed record by slug, and
     hydrates the tile markup (title / description / thumbnail /
     eyebrow / read-time) from the feed.

     Publish is instant: TeamSite only serializes text Datums.
     No DCR references, no external calls, no dep-walk hang risk.

     Optional per-slide overrides let authors tweak eyebrow or
     read-time without touching the case-study DCR itself.

     Deploy alongside the skin:
       /assets/rbccm/css/components/case-studies-carousel.css
       /assets/rbccm/js/components/case-studies-carousel.js

     Depends on: jQuery + accessible-slick (loaded site-wide).

     Consumed by case-studies-carousel.xsl.

     SCHEMA NOTE: only ID, Name, Type are permitted on a Datum,
     and only ID, Name, Replicatable, CloneGroupID on a Group.
     MinReplicates and Required are NOT in TeamSite's schema and
     will fail validation. Counts and required fields are
     enforced in the XSL instead.
     ============================================================ -->
<Properties ComponentID="case-studies-carousel-v2">

  <!-- Section heading (required). RBCDisplay 29/34.8 wt 500 on
       desktop, 24/120% on mobile. Blank falls back to
       "Signature case studies". -->
  <Datum ID="Heading" Type="String" Name="Section Heading">Signature case studies</Datum>

  <!-- Optional intro paragraph below the H2. Textarea because
       copy can run long. Blank drops the paragraph. -->
  <Datum ID="Intro" Type="Textarea" Name="Section Intro (optional)"></Datum>

  <!-- Section aria-label on the <section> wrapper. Blank falls
       back to the Heading. -->
  <Datum ID="AriaLabel" Type="String" Name="Section Aria Label (blank = heading)"></Datum>

  <!-- Optional id="..." on the H2 so anchor links (...#case-studies)
       can jump to the section. When set, CSS applies scroll-margin-top
       to clear the sticky nav. -->
  <Datum ID="HeadingId" Type="String" Name="Section Heading Anchor Id (optional)"></Datum>


  <!-- ═══ TRANSITION MODE ══════════════════════════════════════
       "slide" (default) horizontal slide between cards.
       "fade" cross-fade between cards, no horizontal motion.
       Parsed case-insensitively; unknown values fall back to
       "slide". -->
  <Datum ID="TransitionMode" Type="String" Name="Transition Mode (slide or fade)">slide</Datum>


  <!-- ═══ VIEW ALL CTA ═════════════════════════════════════════
       Outlined pill below the dots. Blank link OR blank label
       drops the whole button. -->
  <Datum ID="CtaLabel" Type="String" Name="View All Button Label (blank = no button)">View all</Datum>
  <Datum ID="CtaLink"  Type="String" Name="View All Button Link (blank = no button)">/en/expertise/transactions</Datum>
  <Datum ID="CtaNewTab" Type="Boolean" Name="Open View All in New Tab">false</Datum>


  <!-- ═══ FEED URL ═════════════════════════════════════════════
       Where the JS fetches case-study metadata from. Default
       points at the shared TeamSite feed component. Override
       per instance only if a different feed is needed (e.g. a
       regional split). -->
  <Datum ID="FeedUrl" Type="String" Name="Feed URL (blank = default case-studies feed)">/en/expertise/transactions/data/case-studies.page</Datum>


  <!-- ═══ ACCESSIBILITY (optional overrides) ══════════════════ -->

  <Datum ID="Locale" Type="String" Name="Locale (en or fr)">en</Datum>

  <!-- accessible-slick regionLabel. Matters when a page carries
       more than one carousel: without distinct labels a screen
       reader announces two identical "region"s. Blank falls
       back to the Section Heading. -->
  <Datum ID="RegionLabel" Type="String" Name="Carousel Region Aria Label (blank = heading)"></Datum>

  <!-- accessible-slick instructionsText. Optional screen-reader
       hint at the START of the carousel. Blank by default and
       usually stays blank - behaviour is obvious. Fill in only
       for non-obvious behaviour. -->
  <Datum ID="InstructionsText" Type="String" Name="Screen Reader Instructions (blank = none)"></Datum>

  <Datum ID="PrevArrowAriaLabel" Type="String" Name="Prev Arrow Aria Label (override)"></Datum>
  <Datum ID="NextArrowAriaLabel" Type="String" Name="Next Arrow Aria Label (override)"></Datum>
  <Datum ID="AriaViewAllLabel"   Type="String" Name="View All Aria Label (override)"></Datum>


  <!-- ═══ SECTION PADDING (optional overrides) ════════════════
       Blank = baked-in defaults (40/16 mobile, 64/24 992+,
       64/170 1440+). Supply any CSS length to override. Written
       as CSS custom properties on the section so the stylesheet
       keeps its defaults and an override is a one-Datum change. -->
  <Datum ID="PadTopMobile"     Type="String" Name="Mobile padding-top (blank = 40px)"/>
  <Datum ID="PadBottomMobile"  Type="String" Name="Mobile padding-bottom (blank = 40px)"/>
  <Datum ID="PadTopDesktop"    Type="String" Name="Desktop padding-top (blank = 64px)"/>
  <Datum ID="PadBottomDesktop" Type="String" Name="Desktop padding-bottom (blank = 64px)"/>

</Properties>

<Data>

  <!-- ═══ CASE STUDY SLIDES ═══════════════════════════════════
       One Group per slide. Author's only required input is the
       case-study URL. Everything else - title, description,
       image, eyebrow, read-time - is read from the shared
       case-studies feed at render time by the JS runtime.

       WORKFLOW
         1. Browse to the case study on the site.
         2. Copy the URL from the address bar.
         3. Paste into the Case Study URL Datum below.
         4. Save + publish. Done.

       PER-SLIDE OVERRIDES (both optional)
         Eyebrow Override    - replaces the eyebrow the feed
                               would show for this record. Use
                               to say "Featured deal" on one
                               specific tile without editing
                               the underlying DCR record.
         Read Time Override  - replaces the "X min" value.

       BEHAVIOUR
         Missing/renamed URLs are silently dropped at render
         time. If every URL fails to match, the carousel shows
         nothing (no broken shells). The gate is intentionally
         soft - lets you queue a not-yet-published case study
         and it'll pop in when the feed refreshes. -->
  <Group ID="Slide"
         Name="Case Study Slide"
         Replicatable="true"
         CloneGroupID="cs-slide">

    <Datum ID="Url"      Type="String" Name="Case Study URL"></Datum>
    <Datum ID="Eyebrow"  Type="String" Name="Eyebrow Override (blank = use feed)"></Datum>
    <Datum ID="ReadTime" Type="String" Name="Read Time Override (blank = use feed)"></Datum>

  </Group>

</Data>
