  <Datum ID="CiAriaInsightsCarouselLabel" Type="String" Name="CI :: ARIA - Insights carousel label"></Datum>
  <Datum ID="CiAriaPrevSpeakerLabel"      Type="String" Name="CI :: ARIA - Previous speaker button"></Datum>
