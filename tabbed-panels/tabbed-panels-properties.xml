  <Datum ID="CiAriaSpeakersDotsLabel"     Type="String" Name="CI :: ARIA - Speakers dots strip"></Datum>
  <Datum ID="CiAriaInsightsDotsLabel"     Type="String" Name="CI :: ARIA - Insights dots strip"></Datum>
  <Datum ID="CiAriaViewAllInsightsLabel"  Type="String" Name="CI :: ARIA - View all insights CTA"></Datum>

