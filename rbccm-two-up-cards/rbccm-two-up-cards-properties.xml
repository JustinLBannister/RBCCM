<!-- ============================================================
     RBCCM Two-Up Cards  |  Properties + Data
     ============================================================
     Reusable 2-up card row. One Properties file shared by two
     skins; the skin picked in TeamSite's Skin dropdown decides
     the variant (there is no preset field):

       rbccm-two-up-cards (double-dash) features.xsl
                       MAAS+MATA parity. Dark section. Each card:
                       eyebrow + title + body + up to 5 bullets.
                       Cards themed dark or light (Card{N}Theme).

       rbccm-two-up-cards (double-dash) video-callouts.xsl
                       "Find conviction" parity. Light section.
                       Each card: image + play button, title,
                       optional subtitle, body, CTA. Play button
                       and CTA open the video modal.

     Each field's label says which skin uses it; the other skin
     ignores it. Blank card title hides that card.

     Where fields live (TeamSite tabs)
     ============================================================
       Properties  ->  Appearance tab: paths, IDs, background
                       colour, heading tag, card themes.
       Data        ->  Content tab: section header copy and all
                       card content.
     The skins read every field with //Datum[@ID=...], so they
     work in either block.
     ============================================================ -->
<Properties ComponentID="rbccm-two-up-cards-v1">

  <!-- ============================================================
       Deploy plumbing
       ============================================================ -->
  <Datum ID="CssPath" Type="String" Name="CSS path (absolute URL)">/assets/rbccm/css/components/rbccm-two-up-cards.css</Datum>
  <Datum ID="JsPath" Type="String" Name="JS path : video modal (video-callouts skin only)">/assets/rbccm/js/components/rbccm-two-up-cards.js</Datum>
  <Datum ID="CacheVersion" Type="String" Name="Cache version (format YYYY-MM-DD-HHMM)">2026-09-17-1200</Datum>
  <Datum ID="SectionID" Type="String" Name="Section ID (optional - anchor target)">rbccm-two-up-cards-1</Datum>
  <Datum ID="SectionAriaLabel" Type="String" Name="Section aria-label (optional - defaults to heading text)"></Datum>

  <!-- ============================================================
       Look
       ============================================================
       Background colour: blank uses the skin default (features =
       navy, video-callouts = white). Heading tag: h1-h6, default
       h2. Card themes: features skin only. -->
  <Datum ID="SectionBgColor" Type="String" Name="Section background colour e.g. '#041e42' (optional - blank uses the skin default)"></Datum>
  <Datum ID="SectionHeadingTag" Type="String" Name="Section heading tag (h1-h6 - default h2)">h2</Datum>
  <Datum ID="Card1Theme" Type="String" Name="Card 1 : theme - type dark or light (features skin)">dark</Datum>
  <Datum ID="Card2Theme" Type="String" Name="Card 2 : theme - type dark or light (features skin)">light</Datum>

</Properties>

<Data>

  <!-- ============================================================
       Section header  (all optional)
       ============================================================
       Eyebrow: small caption above the heading. Heading: the
       section heading (tag set on the Appearance tab).
       Description: paragraph below the heading. -->
  <Datum ID="SectionEyebrowText" Type="String" Name="Section eyebrow (optional - small yellow caption above heading)">Two platforms, one connected workflow</Datum>
  <Datum ID="SectionHeadingText" Type="String" Name="Section heading (optional)">Better insight for stronger execution</Datum>
  <Datum ID="SectionDescriptionText" Type="Textarea" Name="Section description (optional - paragraph below heading)"></Datum>

  <!-- ============================================================
       Cards
       ============================================================
       TitleText        headline (blank hides the card)
       BodyText         paragraph copy
       EyebrowText      small tag on the card (features skin)
       Bullet1-5Text    bullet list (features skin, blank skips)
       SubtitleText     line between title and body (video-callouts skin)
       MediaImagePath   image URL (video-callouts skin)
       MediaImageAlt    image alt text (video-callouts skin)
       VideoUrl         opens in the modal: YouTube, Vimeo,
                        Brightcove player URL or .mp4 (video-callouts skin)
       CtaLabel         e.g. 'Watch the video' (video-callouts skin)
       CtaHref          link target when VideoUrl is blank (video-callouts skin)
       ============================================================ -->

  <!-- ============================================================
       Card 1
       ============================================================ -->
