  <Datum ID="Card1SubtitleText" Type="String" Name="Card 1 : subtitle (video-callouts skin - optional line between title and body)"></Datum>
  <Datum ID="Card1BodyText" Type="Textarea" Name="Card 1 : body copy">Turn cross-asset insight into actionable pre-trade intelligence, helping you evaluate execution decisions before you move.</Datum>
  <Datum ID="Card1MediaImagePath" Type="String" Name="Card 1 : media image path (video-callouts skin)"></Datum>
  <Datum ID="Card1MediaImageAlt" Type="String" Name="Card 1 : media image alt (video-callouts skin)"></Datum>
  <Datum ID="Card1VideoUrl" Type="String" Name="Card 1 : video URL (video-callouts skin - opens in modal)"></Datum>
  <Datum ID="Card1CtaLabel" Type="String" Name="Card 1 : CTA label (video-callouts skin - e.g. 'Watch the video')"></Datum>
  <Datum ID="Card1CtaHref" Type="String" Name="Card 1 : CTA href (video-callouts skin - used when VideoUrl blank)"></Datum>
  <Datum ID="Card1Bullet1Text" Type="String" Name="Card 1 : bullet 1 (features skin)">Quantify expected execution costs before commitment</Datum>
  <Datum ID="Card1Bullet2Text" Type="String" Name="Card 1 : bullet 2 (features skin)">Compare strategies side by side to evaluate potential outcomes</Datum>
  <Datum ID="Card1Bullet3Text" Type="String" Name="Card 1 : bullet 3 (features skin)">Explore interactive outlier views to focus on higher-risk or harder-to-trade orders</Datum>
  <Datum ID="Card1Bullet4Text" Type="String" Name="Card 1 : bullet 4 (features skin)">Monitor market conditions and portfolio exposures</Datum>
  <Datum ID="Card1Bullet5Text" Type="String" Name="Card 1 : bullet 5 (features skin)">Model scenarios across asset classes</Datum>

  <!-- ============================================================
       Card 2
       ============================================================ -->
  <Datum ID="Card2EyebrowText" Type="String" Name="Card 2 : eyebrow (features skin - e.g. 'MAAS - Execution')">MAAS - Execution</Datum>
  <Datum ID="Card2TitleText" Type="String" Name="Card 2 : title (blank hides the card)">Drive stronger performance outcomes</Datum>
  <Datum ID="Card2SubtitleText" Type="String" Name="Card 2 : subtitle (video-callouts skin - optional line between title and body)"></Datum>
  <Datum ID="Card2BodyText" Type="Textarea" Name="Card 2 : body copy">Turn trading insight into disciplined execution, with advanced technology designed to adapt as market conditions change.</Datum>
  <Datum ID="Card2MediaImagePath" Type="String" Name="Card 2 : media image path (video-callouts skin)"></Datum>
  <Datum ID="Card2MediaImageAlt" Type="String" Name="Card 2 : media image alt (video-callouts skin)"></Datum>
  <Datum ID="Card2VideoUrl" Type="String" Name="Card 2 : video URL (video-callouts skin - opens in modal)"></Datum>
  <Datum ID="Card2CtaLabel" Type="String" Name="Card 2 : CTA label (video-callouts skin)"></Datum>
  <Datum ID="Card2CtaHref" Type="String" Name="Card 2 : CTA href (video-callouts skin - used when VideoUrl blank)"></Datum>
  <Datum ID="Card2Bullet1Text" Type="String" Name="Card 2 : bullet 1 (features skin)">Access adaptive algorithms built for live market conditions</Datum>
  <Datum ID="Card2Bullet2Text" Type="String" Name="Card 2 : bullet 2 (features skin)">Select AI-powered strategies tailored to execution objectives</Datum>
