  <Datum ID="SectionSubtitleText" Type="Textarea" Name="Section subtitle (optional - blank hides the subtitle; HTML allowed)">Insights from across RBC Capital Markets' global platform.</Datum>
  <Datum ID="SectionSubtitleTag" Type="SelectSingle" Name="Section subtitle tag (optional - controls the HTML tag for SEO / a11y)">
