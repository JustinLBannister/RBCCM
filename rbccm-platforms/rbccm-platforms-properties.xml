    strategy-and-economics-platforms
  </Datum>


  <!-- ============================================================
       Section header
       ============================================================
       What editors set here: the big headline and short subtitle
       that sit at the top of the section. The tag pickers let you
       promote the title to h2 for SEO.
       .............................................................
       Header alignment. left = base (no modifier); center adds the
       .rbccm-platforms__header-center modifier that centers the
       title + subtitle block. The S+E preset previously hard-coded
       center on the header; that override was removed so this Datum
       drives the alignment. (Class name uses __ substitution for the
       BEM modifier so this XML comment stays well-formed; emitted
       markup uses the double-hyphen prefix.)
       ============================================================ -->
  <Datum ID="HeaderAlignment" Type="SelectSingle" Name="Header alignment (optional - controls how the title block is aligned)">
    <Option Selected="true"><Display>Left</Display><Value>left</Value></Option>
    <Option><Display>Center</Display><Value>center</Value></Option>
    left
  </Datum>

