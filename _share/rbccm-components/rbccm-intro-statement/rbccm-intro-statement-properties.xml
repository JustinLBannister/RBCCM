<!-- ============================================================
     RBCCM Intro Statement  |  Properties + Data
     ============================================================
     Big centred serif statement + up to 3 paragraphs + a ghost pill
     CTA (the MAAS+MATA "A new standard for multi-asset electronic
     trading." section). Transparent background by default so it sits
     inside the MAAS+MATA dark strip (use rbccm-section-group around it).

     Heading is three parts, all the same size:
       Lead       grey  (own line)   "A new standard for"
       Highlight  white (own line)   "multi-asset"
       Accent     yellow, after the highlight "electronic trading."
     Blank fields don't render.

     Deploy alongside:
       /assets/rbccm/css/components/rbccm-intro-statement.css
     ============================================================ -->
<Properties ComponentID="rbccm-intro-statement-v1">

  <!-- ============================================================
       Appearance tab: settings, paths, layout, tags, colours
       ============================================================ -->

  <Datum ID="CssPath" Type="String" Name="CSS path (technical - blank uses the default)">/assets/rbccm/css/components/rbccm-intro-statement.css</Datum>

  <Datum ID="CacheVersion" Type="String" Name="Last updated (bump each time you save - format YYYY-MM-DD-HHMM)">2026-09-28-1200</Datum>

  <Datum ID="SectionID" Type="String" Name="Section ID (optional - anchor target)"></Datum>

  <Datum ID="SectionAriaLabel" Type="String" Name="Section aria-label (optional - blank uses the heading text)"></Datum>

  <Datum ID="SectionBgColor" Type="String" Name="Background colour (optional - blank = transparent, e.g. inside the MAAS+MATA dark strip)"></Datum>

  <Datum ID="HeadingTag" Type="String" Name="Heading tag - type h1, h2, h3, p or div (blank = h2)">h2</Datum>

</Properties>

<Data>

  <!-- ============================================================
       Content tab: copy, links, media
       ============================================================ -->

  <Datum ID="HeadingLead" Type="String" Name="Heading - lead, grey (a br tag here breaks the line on phones only; put a space before it)">A new &lt;br&gt;standard for</Datum>

  <Datum ID="HeadingHighlight" Type="String" Name="Heading - highlight, white">multi-asset</Datum>

  <Datum ID="HeadingAccent" Type="String" Name="Heading - accent, yellow (include closing punctuation)">electronic trading.</Datum>

  <Datum ID="Paragraph1" Type="Textarea" Name="Paragraph 1 (blank hides it)">Trading desks are evolving, and the gap between real-time intelligence and multi-asset execution is closing fast.</Datum>

  <Datum ID="Paragraph2" Type="Textarea" Name="Paragraph 2 (blank hides it)">MAAS is our execution platform. It works hand in hand with &lt;strong&gt;MATA&lt;/strong&gt;, our analytics platform &#8212; together, two complementary capabilities that connect pre-trade intelligence to disciplined execution across all major asset classes and index events.</Datum>

  <Datum ID="Paragraph3" Type="Textarea" Name="Paragraph 3 (blank hides it)">Because in complex markets, the traders who win aren't just faster - they're better informed, better connected, and better positioned to execute.</Datum>

  <Datum ID="CtaLabel" Type="String" Name="Button label (blank hides the button)">See MAAS in action</Datum>

  <Datum ID="CtaHref" Type="String" Name="Button URL (e.g. #platform to jump to the platforms section)">#platform</Datum>

  <Datum ID="CtaAriaLabel" Type="String" Name="Button aria-label (optional - only if the label alone isn't clear)"></Datum>

</Data>
