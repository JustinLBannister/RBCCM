<!-- ============================================================
     RBCCM JSON Schema (JSON-LD structured data)  |  Properties
     ============================================================
     Standalone component for injecting Google-readable JSON-LD
     structured data into any page. Drop-in replacement for the
     SeoJsonLd Datum that used to live inside maas-mata.

     How editors use it
     ============================================================
     1. Add this component to any TeamSite page/section.
     2. Get the finished @graph block from SEO (Joon or whoever
        owns structured data).
     3. Content tab: paste ONLY the JSON object into the SeoJsonLd
        field (between the CDATA markers when editing this file).
        Do NOT include the &lt;script&gt; tags or any surrounding
        HTML comment; the component emits the &lt;script&gt; wrapper
        for you.
     4. Publish. Validate at Google's Rich Results Test:
        https://search.google.com/test/rich-results

     What ships to the page
     ============================================================
     &lt;script type="application/ld+json"&gt;
       { "@context": "https://schema.org", "@graph": [ ... ] }
     &lt;/script&gt;

     Guard: when the Datum is empty the component emits nothing,
     so an unfilled placeholder never ships a broken empty stub.
     ============================================================ -->
<Properties ComponentID="rbccm-json-schema-v1">
</Properties>

<!-- Content tab. The JSON-LD is content SEO supplies, so it lives in
     Data like the copy in the other components (it was on the
     Appearance tab until 2026-10-13). The skin reads it with
     //Datum[@ID='SeoJsonLd'], so either location renders. -->
<Data>

  <!-- ============================================================
       SEO / JSON-LD structured data
       ============================================================
       Single Textarea holding the entire JSON-LD @graph block.
       When SEO delivers a new schema, paste the whole thing here
       (no field-by-field re-entry). The XSL wraps this value in
       a &lt;script type="application/ld+json"&gt; tag verbatim.
       Write a literal &amp; or &lt; inside a JSON string as the JSON
       escape \u0026 / \u003c, NOT as the HTML entity &amp;amp;amp; /
       &amp;amp;lt;. The value is output without decoding, so an entity
       shows on the page as-is (the live MAAS block had
       &quot;ETFs &amp;amp;amp; ADRs&quot; this way, 2026-10-13).
       ============================================================ -->
  <!-- IMPORTANT: keep the CDATA wrapper below when editing this Datum.
       TeamSite otherwise entity-encodes square brackets and injects
       stray template markers into JSON strings, which breaks the
       structured data. CDATA tells TeamSite "hand this back verbatim,
       don't touch it." Paste the full JSON block from SEO between
       the &lt;![CDATA[ and ]]&gt; markers. -->
  <Datum ID="SeoJsonLd" Type="Textarea" Name="SEO: JSON-LD &#8212; paste ONLY the JSON object. START at the opening { before &quot;@context&quot;. END at its matching closing }. Do NOT paste the &lt;script&gt; tags or the &lt;!-- Schema --&gt; comment (the component emits the &lt;script&gt; wrapper for you). Keep the CDATA wrapper below."><![CDATA[
]]></Datum>

</Data>
