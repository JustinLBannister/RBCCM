<!-- ============================================================
     CTA Band — Properties + Data
     ============================================================
     Shared component. Three visual presets pick the surface,
     typography, and button layout; individual Datums fill in the
     copy for whichever preset is selected.

     Variants (Preset Datum)
     ───────────────────────────────────────────────────────────
       maas-mata   Big serif heading (up to 75px) with a
                             yellow-highlight last span, single
                             yellow pill CTA, own navy gradient.
                             Pattern from MAAS+MATA "Talk with an
                             expert."

       strategy-and-economics       Small serif heading (28px), body copy,
                             TWO buttons (primary yellow + secondary
                             outlined ghost). Deep-navy bg. Pattern
                             from S&E "Log in to RBC insights".

       us-credentials        Same big serif ramp as talk-with-an-
                             expert but the heading uses flex-column
                             at desktop so the yellow highlight
                             always drops beneath the white lead
                             regardless of copy length. No eyebrow
                             slot on this variant. Pattern from US
                             Credentials "Ready to turn insights
                             into results?"

     Modifier (BgTransparent Datum)
     ───────────────────────────────────────────────────────────
       yes → adds the bg-transparent modifier class, which zeros
             the section's own background so a parent wrapper (like
             MAAS+MATA's .rbccm-maas-mata__deep-band) can paint a
             continuous gradient through the band. Leave "no" for
             standalone use.

     Deploy alongside:
       /assets/rbccm/css/components/rbccm-cta-band.css
     ============================================================ -->
<Properties ComponentID="cta-band-v2">

  <!-- ============================================================
       Appearance tab: settings, paths, layout, tags, colours
       ============================================================ -->

  <Datum ID="Preset" Type="Enum" Name="Variant" Default="maas-mata">
    <Option Value="maas-mata">Talk with an expert (big serif + 1 yellow CTA)</Option>
    <Option Value="strategy-and-economics">Research portal (small serif + 2 buttons)</Option>
    <Option Value="us-credentials">US Credentials (big serif, wrapping heading, 1 yellow CTA)</Option>
  </Datum>

  <Datum ID="BgTransparent" Type="Enum" Name="Transparent background (use inside a wrapper that owns the gradient)" Default="no">
    <Option Value="no">No — paint the variant's own background</Option>
    <Option Value="yes">Yes — inherit the parent wrapper's background</Option>
  </Datum>

  <Datum ID="SectionId"        Type="String" Name="Section id (optional — for anchor links)"></Datum>

  <Datum ID="SectionAriaLabel" Type="String" Name="Section aria-label (optional)"></Datum>

</Properties>

<Data>

  <!-- ============================================================
       Content tab: copy, links, media
       ============================================================ -->

  <!-- Eyebrow — small yellow caption above the heading. Leave
       blank to omit it entirely. Only rendered when non-empty
       (production variants: maas-mata uses it,
       us-credentials + strategy-and-economics typically leave it blank). -->
  <Datum ID="Eyebrow" Type="String" Name="Eyebrow (optional — leave blank to omit)"></Datum>

  <!-- Heading — split into a lead (white) and an optional
       highlight (yellow). If Highlight is blank, only the lead
       renders. On the us-credentials preset each half stacks on
       its own line at desktop (flex-column); the other presets
       flow inline with a non-breaking space between them.

       Examples per preset:
         maas-mata  Lead: "Talk with an"          Highlight: "expert."
         us-credentials       Lead: "Ready to turn insights" Highlight: "into results?"
         strategy-and-economics      Lead: "Explore our full library of research and insights"
                              Highlight: (blank)                                     -->
  <Datum ID="HeadingLead" Type="String" Name="Heading — lead (white)">Talk with an</Datum>

  <Datum ID="HeadingHighlight" Type="String" Name="Heading — highlight (yellow; leave blank for a single-color heading)">expert.</Datum>

  <!-- Body paragraph. Textarea so authors can paste multi-line
       or lightly-formatted copy. Inline HTML supported (bold /
       italic / anchor) via the XSL's disable-output-escaping.
       Leave blank to omit. -->
  <Datum ID="Body" Type="Textarea" Name="Body copy (optional)">Connect with our product teams to arrange a custom demo.</Datum>

  <Datum ID="Cta1Label" Type="String" Name="Primary button — label">Request a demo</Datum>

  <Datum ID="Cta1Href"  Type="String" Name="Primary button — URL">#demo</Datum>

  <Datum ID="Cta2Label" Type="String" Name="Secondary button — label (strategy-and-economics only; leave blank to omit)"></Datum>

  <Datum ID="Cta2Href"  Type="String" Name="Secondary button — URL"></Datum>

</Data>
