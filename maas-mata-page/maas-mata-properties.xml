  <Datum ID="Award1Issuer" Type="String" Name="Award 1 — issuer">TradingTech Insights Awards USA</Datum>
  <Datum ID="Award2Year" Type="String" Name="Award 2 — year">2025</Datum>
  <Datum ID="Award2Title" Type="String" Name="Award 2 — title">Overall Best Provider, Algorithmic Trading</Datum>
  <Datum ID="Award2Issuer" Type="String" Name="Award 2 — issuer">The Trade</Datum>
  <Datum ID="Award3Year" Type="String" Name="Award 3 — year">2025</Datum>
