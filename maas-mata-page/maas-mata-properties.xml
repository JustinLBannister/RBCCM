  <!-- ═══ 5b. PLATFORM CARDS (2 fixed slots) ═════════════════ -->
  <Datum ID="Platform1Theme" Type="SelectSingle" Name="Platform 1 — theme">
    <Option Selected="true"><Display>Dark (navy card)</Display><Value>dark</Value></Option>
