<!-- ============================================================
     MAAS + MATA Landing Page — Properties + Data
     ============================================================
     One-component skin for the MAAS + MATA landing page. Every
     author-editable string / image / repeater is exposed here.
     Rendered by maas-mata.xsl (single .xsl file, inline CSS + JS).

     Sections (mirrors current live DOM):
       1  Hero              eyebrow, two-tone title, subtitle, CTA
       2  Chart Card        static image + Brightcove video modal
       3  New Standard      3-colour headline + body + yellow CTA
       4  Awards            eyebrow + 3 fixed slots (year/title/issuer)
       5  Platforms         two cards (MATA analytics, MAAS execution)
       6  Innovation Era    3 numbered features (fixed slots)
       7  MATA Capabilities eyebrow + heading + 3-card grid +
                            fixed "Index events" wide card
       8  Demo CTA          eyebrow + "Talk with an <highlight>."

     Newsletter is NOT in this component. The site-wide Marketo
     component is dropped on the page separately. Market Insights
     was also removed in the current live layout.

     Appearance (section-level):
       ColorScheme, background overrides, per-section padding

     SCHEMA NOTE (per story-tiles-featured convention):
       Only ID, Name, Type are permitted on a Datum.
       Only ID, Name, Replicatable, CloneGroupID on a Group.
       MinReplicates / Required are enforced in the XSL, not here.

     Deploy alongside the skin:
       /assets/rbccm/css/pages/maas-mata.css
       /assets/rbccm/js/pages/maas-mata.js
       /assets/rbccm/js/pages/rbccm-json-bind.js (shared runtime)
     ============================================================ -->
<Properties ComponentID="maas-mata-v1">

  <!-- ═══ 0. ASSET VERSION ═══════════════════════════════════
       Cache-buster appended as ?v=<value> to every CSS/JS URL
       emitted by the XSL. Bump this value whenever a new
       maas-mata.css, maas-mata.js, or rbccm-json-bind.js is
       deployed. Format: YYYY-MM-DD-HHMM (24-hour, sorts
       chronologically, unique per minute). Any short unique
       string also works — semver, git sha, etc. -->
  <Datum ID="AssetVersion" Type="String" Name="Asset version (cache-buster) — bump on any CSS/JS deploy. Format: YYYY-MM-DD-HHMM">2026-09-14-1120</Datum>

  <!-- ═══ 1. HERO ════════════════════════════════════════════
       Eyebrow renders above a yellow 45x2 underline. Title is
       a two-line H1 with per-line colour (line 1 dark navy,
       line 2 bright blue). Subtitle wraps to 3 lines on mobile
       and full width on desktop. -->
  <Datum ID="HeroEyebrow" Type="String" Name="Hero eyebrow">Multi Asset Analytics &amp; Execution</Datum>
  <Datum ID="HeroTitleLine1" Type="String" Name="Hero title — line 1 (dark navy)">Trade with clarity.</Datum>
  <Datum ID="HeroTitleLine2" Type="String" Name="Hero title — line 2 (bright blue)">Execute with control.</Datum>
  <Datum ID="HeroSubtitle" Type="Textarea" Name="Hero subtitle">RBC Capital Markets&#8217; Multi Asset Agency Solutions (MAAS) connects intelligence to execution, working alongside &lt;strong&gt;MATA&lt;/strong&gt; &#8212; our Multi-Asset Trade Analytics platform &#8212; so insight and action stay connected across asset classes.</Datum>
  <Datum ID="HeroCtaLabel" Type="String" Name="Hero CTA label">Request demo</Datum>
  <Datum ID="HeroCtaHref" Type="String" Name="Hero CTA URL">#demo</Datum>


  <!-- ═══ 2. CHART CARD (image + optional Brightcove modal) ═══
       Static screenshot per client direction. Single image
       scales down for mobile via CSS. Blank Brightcove Video
       Id hides the play button. -->
  <Datum ID="ChartImage" Type="String" Name="Chart image URL (upload to /assets/rbccm/images/... then paste the path here)">/assets/rbccm/images/expertise/global-markets/electronic-trading/multi-asset-agency-solutions/maas-execution-console-reveal.png</Datum>
  <Datum ID="ChartImageAlt" Type="String" Name="Chart image alt text">MAAS Execution Console — cross-asset portfolio chart with +$15,500.90 delta and live quote strip.</Datum>
  <!-- Brightcove account + player are RBC-wide constants — same on
       every video hosted on the site. Only the Video ID changes when
       a new video ships. -->
  <Datum ID="ChartBrightcoveAccount" Type="String" Name="Brightcove account ID (RBC-wide constant — do not change)">6021289101001</Datum>
  <Datum ID="ChartBrightcovePlayer"  Type="String" Name="Brightcove player ID (RBC-wide constant — do not change)">VyvCc9BZx</Datum>
  <Datum ID="ChartBrightcoveVideoId" Type="String" Name="Brightcove video ID (this is the one that changes per video; blank falls back to the FPO clip)">6385114247112</Datum>


  <!-- ═══ 3. NEW STANDARD ═════════════════════════════════════
       Headline is split into 3 colour stops:
         Lead     grey    "A new standard for"
         Highlight white   "multi-asset"
         Accent   yellow  "trading"
       Body is 3 fixed paragraph Datums (see NewStandardParagraph1..3
       below). -->
  <!-- Lead accepts &lt;br&gt; to force the mobile 2-line break
       ("A new" / "standard for"). At 600+ the br is CSS-hidden so
       the copy flows full-width — the space BEFORE the br is what
       keeps the words separated in that flowed layout. Emitted via
       data-json-html + XSL disable-output-escaping so the tag
       survives to the DOM. -->
  <Datum ID="NewStandardHeadingLead" Type="String" Name="New-standard headline — lead (grey; include a space before &lt;br&gt;)">A new &lt;br&gt;standard for</Datum>
  <Datum ID="NewStandardHeadingHighlight" Type="String" Name="New-standard headline — highlight (white)">multi-asset</Datum>
  <!-- Accent includes the closing period so it inherits the yellow. -->
  <Datum ID="NewStandardHeadingAccent" Type="String" Name="New-standard headline — accent (yellow; include closing punctuation)">electronic trading.</Datum>
  <Datum ID="NewStandardCtaLabel" Type="String" Name="New-standard CTA label">See MAAS in action</Datum>
  <Datum ID="NewStandardCtaHref" Type="String" Name="New-standard CTA URL">#platform</Datum>


  <!-- ═══ 5. PLATFORMS ═══════════════════════════════════════
       Section-level eyebrow + heading precede the two cards
       (defined below as fixed slot Datums). -->
  <Datum ID="PlatformsEyebrow" Type="String" Name="Platforms eyebrow">Two platforms, one connected workflow</Datum>
  <Datum ID="PlatformsHeading" Type="String" Name="Platforms heading">Better insight for stronger execution</Datum>


  <!-- ═══ 6. INNOVATION ERA ══════════════════════════════════
       Light-cream section. Heading + intro copy precede a
       numbered features repeater (defined below). -->
  <Datum ID="InnovationEraHeading" Type="String" Name="Innovation-era heading">Innovation for the next execution era</Datum>
  <Datum ID="InnovationEraBody" Type="Textarea" Name="Innovation-era intro copy">Technology, scale and multi-asset expertise — engineered to help you execute with confidence.</Datum>


  <!-- ═══ 7. MATA CAPABILITIES ═══════════════════════════════
       Yellow eyebrow + white heading + subtitle above a
       3-card grid + one wider "Index events" info card. The
       3 grid cards live below as fixed slot Datums. Index Events
       is authored here as a fixed card. -->
  <!-- Optional eyebrow. Leave blank to hide the row entirely; the XSL
       skips the div when this Datum is empty. -->
  <Datum ID="MataCapEyebrow" Type="String" Name="MATA capabilities eyebrow (leave blank to hide)"></Datum>
  <Datum ID="MataCapHeading" Type="String" Name="MATA capabilities heading">Sharper insight. Smarter trades.</Datum>
  <Datum ID="MataCapSubheading" Type="Textarea" Name="MATA capabilities subheading">Explore MATA capabilities across core asset classes, with specialized index intelligence for event-driven trading decisions.</Datum>

  <!-- Index Events fixed card (renders full width below the
       3-card grid). Icon is a SelectSingle so authors can swap
       between the pre-built SVG symbols in the sprite. -->
  <Datum ID="IndexEventsIcon" Type="SelectSingle" Name="Index Events icon">
    <Option><Display>Equities (trend arrow)</Display><Value>equities</Value></Option>
    <Option><Display>FX (crossed arrows)</Display><Value>fx</Value></Option>
    <Option><Display>Futures (chart bars)</Display><Value>futures</Value></Option>
    <Option Selected="true"><Display>Info (magnifying glass)</Display><Value>info</Value></Option>
  </Datum>
  <Datum ID="IndexEventsTitle" Type="String" Name="Index Events title">Index events</Datum>
  <Datum ID="IndexEventsSubtitle" Type="String" Name="Index Events subtitle">120+ Global Indices</Datum>
  <Datum ID="IndexEventsBody" Type="Textarea" Name="Index Events body">Anticipate index changes before rebalances with analytics shaped by RBC Capital Markets' Program Trading team, including expected additions, deletions, upweights and downweights, corporate action analysis, spread analytics and symbol-level share impact estimates.</Datum>


  <!-- ═══ 8. DEMO CTA ════════════════════════════════════════
       Headline is split — prefix in white, highlight word in
       yellow. Yellow pill CTA below. -->
  <Datum ID="DemoEyebrow" Type="String" Name="Demo eyebrow">See the platform</Datum>
  <Datum ID="DemoHeadlinePrefix" Type="String" Name="Demo headline — prefix (white)">Talk with an </Datum>
  <Datum ID="DemoHeadlineHighlight" Type="String" Name="Demo headline — highlight (yellow)">expert</Datum>
  <Datum ID="DemoBody" Type="Textarea" Name="Demo body">Connect with our product teams to arrange a custom demo.</Datum>
  <Datum ID="DemoCtaLabel" Type="String" Name="Demo CTA label">Request a demo</Datum>
  <Datum ID="DemoCtaHref" Type="String" Name="Demo CTA URL">#demo</Datum>


  <!-- ═══ APPEARANCE (section-level, optional) ═══════════════
       ColorScheme flips the whole page tone. BackgroundColor
       is a full-page override (rare — the deep-band gradient
       usually reads correctly on any background). -->
  <Datum ID="ColorScheme" Type="SelectSingle" Name="Color Scheme">
    <Option Selected="true">
      <Display>Default (mixed light + dark bands)</Display>
      <Value>default</Value>
    </Option>
    <Option>
      <Display>Dark (all bands dark navy)</Display>
      <Value>dark</Value>
    </Option>
  </Datum>


  <!-- Page <title> + meta description live on the parent page
       skin, not on this component. Author them there. -->


  <!-- ═══ 3b. NEW STANDARD BODY (3 fixed paragraphs) ═════════ -->
  <Datum ID="NewStandardParagraph1" Type="Textarea" Name="New-standard paragraph 1">Trading desks are evolving, and the gap between real-time intelligence and multi-asset execution is closing fast.</Datum>
  <Datum ID="NewStandardParagraph2" Type="Textarea" Name="New-standard paragraph 2">MAAS is our execution platform. It works hand in hand with &lt;strong&gt;MATA&lt;/strong&gt;, our analytics platform &#8212; together, two complementary capabilities that connect pre-trade intelligence to disciplined execution across all major asset classes and index events.</Datum>
  <Datum ID="NewStandardParagraph3" Type="Textarea" Name="New-standard paragraph 3">Because in complex markets, the traders who win aren't just faster - they're better informed, better connected, and better positioned to execute.</Datum>


  <!-- ═══ 4. AWARDS (3 fixed slots) ══════════════════════════ -->
  <Datum ID="AwardsEyebrow" Type="String" Name="Awards eyebrow">See why the world's top institutions choose MAAS</Datum>
