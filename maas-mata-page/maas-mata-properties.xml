  <!-- ═══ 8a. SEO: JSON-LD structured data ═══════════════════
       Single Textarea holding the entire JSON-LD @graph block.
       When SEO (Joon) delivers a new schema, paste the whole
       thing here — no field-by-field re-entry. The XSL wraps
       this value in a <script type="application/ld+json"> tag
       verbatim. Escape any literal < or & to &lt; / &amp; only
       if the schema contains them (most JSON-LD doesn't).
       ═══════════════════════════════════════════════════════════ -->
  <!-- IMPORTANT: keep the CDATA wrapper below when editing this Datum.
       TeamSite otherwise entity-encodes square brackets and injects
       stray template markers into JSON strings, which breaks the
       structured data. CDATA tells TeamSite "hand this back verbatim,
       don't touch it." Paste the full JSON block from SEO between
       the <![CDATA[ and ]]> markers. -->
  <Datum ID="SeoJsonLd" Type="Textarea" Name="SEO: JSON-LD structured data (paste full @graph block from SEO, keep CDATA wrapper)"><![CDATA[
]]></Datum>

</Properties>

