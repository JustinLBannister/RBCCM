{
  "name": "rbccm-components",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RBCCM component library + per-page CSS/JS bundles",
  "scripts": {
    "build": "node build/build.mjs",
    "watch": "node build/build.mjs --watch",
    "list": "node build/build.mjs --list",
    "inventory": "node build/build.mjs --inventory",
    "package": "node build/package.mjs",
    "dashboard": "node build/dashboard.mjs",
    "stories": "node build/stories.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "node build/storybook-static.mjs",
    "global": "node rbccm-global/build-global.mjs",
    "global:bundle": "node rbccm-global/bundle-global.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "acorn": "^8.14.0",
    "esbuild": "^0.25.0",
    "storybook": "^10.6.7",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
